# Recover half of a mid-cycle checkpoint/recover pair (see
# checkpoint-openpmd-midcycle.par): recovers the frozen checkpoint written at
# iteration 6, where the clocks are 2, 3/2 and 3/2 coarse steps, and
# continues to iteration 8. Level 2 is aligned with level 1 in the finest
# clock group [1,3), which the driver restricted at its last end of step.
# Recovery prolongates state and state_nr into level 2's coarse-fine ghosts,
# as ProlongateAfterRestriction did for both. Level 1 lags level 0, so
# recovery replays the dense output into its ghosts from the source bands
# that the mid-cycle checkpoint carries.
#
# For iterations 7 and 8, state, state_nr and error must equal the
# uninterrupted run's bit for bit. Had evolution left state_nr's ghosts on
# level 2 at the dense output, prolongating them here would differ from it
# by far more than the testsuite tolerance.

ActiveThorns = "
    BoxInBox
    CarpetX
    IOUtil
    ODESolvers
    TestSubcyclingNoRestrict
"

$out_every = 1
$nlevels = 3
$ncells = 32

TestSubcyclingNoRestrict::amplitude = -1.0
TestSubcyclingNoRestrict::gaussian_width = 0.17677669529 # sqrt(2)*W = 0.25
TestSubcyclingNoRestrict::u_floor = -0.01

CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no

CarpetX::poison_undefined_values = yes
CarpetX::verbose = no

Cactus::cctk_show_schedule = yes
Cactus::presync_mode = "mixed-error"

CarpetX::xmin = -4.0
CarpetX::ymin = -4.0
CarpetX::zmin = -4.0

CarpetX::xmax = +4.0
CarpetX::ymax = +4.0
CarpetX::zmax = +4.0

CarpetX::ncells_x = $ncells
CarpetX::ncells_y = $ncells
CarpetX::ncells_z = $ncells

Driver::periodic = "yes"
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes

CarpetX::max_num_levels = $nlevels
Driver::regrid_every = 128
Driver::regrid_error_threshold = 0.9

CarpetX::prolongation_type = "ddf"
CarpetX::ghost_size = 3
CarpetX::dtfac = 0.25

CarpetX::blocking_factor_x = 2
CarpetX::blocking_factor_y = 2
CarpetX::blocking_factor_z = 2

BoxInBox::num_regions = 1
# Region 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = $nlevels
BoxInBox::radius_1 = [ -1.0, 1.0, 0.5 ]

Cactus::terminate = "iteration"
Cactus::cctk_itlast = 8

ODESolvers::method = "RK4"

IO::out_dir = $parfile
IO::out_every = $out_every
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no
CarpetX::out_initial_data = no

CarpetX::out_tsv_vars = "
    TestSubcyclingNoRestrict::state
    TestSubcyclingNoRestrict::state_nr
    TestSubcyclingNoRestrict::error
"

IO::checkpoint_dir = $parfile
IO::checkpoint_ID = no
IO::checkpoint_every = 0
IO::checkpoint_on_terminate = no

CarpetX::recover_method = "openpmd"
IO::recover_dir = "../../../arrangements/CarpetX/TestSubcyclingNoRestrict/test/checkpoints-openpmd-midcycle"
IO::recover = "autoprobe"
