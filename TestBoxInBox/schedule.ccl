SCHEDULE GROUP TestBoxInBox_UpdateBoxes AT postinitial BEFORE EstimateError
{
} "Update initial grid structure"

SCHEDULE GROUP TestBoxInBox_UpdateBoxes AT poststep BEFORE EstimateError
{
} "Update grid structure"

SCHEDULE GROUP TestBoxInBox_UpdateBoxes AT post_recover_variables BEFORE EstimateError
{
} "Update grid structure"

SCHEDULE TestBoxInBox_Update IN TestBoxInBox_UpdateBoxes
{
  LANG: C
  OPTIONS: global
  READS: BoxInBox::active
  READS: BoxInBox::num_levels
  READS: BoxInBox::positions
