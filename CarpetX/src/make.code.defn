SRCS =

SUBDIRS = util traversal hierarchy comm ops io schedule api flesh

export EXTRA_DEFINES := $(sort $(EXTRA_DEFINES) CARPETX_INTERNAL)

STRAY_SRCS := $(notdir $(wildcard $(SRCDIR)/*.cxx))
STRAY_DIRS := $(sort $(filter-out $(SUBDIRS) include,$(notdir $(patsubst %/,%,$(dir $(wildcard $(SRCDIR)/*/*.cxx))))))
ifneq ($(STRAY_SRCS)$(STRAY_DIRS),)
$(error CarpetX/src/make.code.defn: not in SUBDIRS: $(strip $(STRAY_SRCS) $(STRAY_DIRS)))
endif
