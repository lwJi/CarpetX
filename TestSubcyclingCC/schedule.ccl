# Schedule definitions for thorn TestSubcyclingCC

STORAGE: state rhs error state_norestrict rhs_norestrict


SCHEDULE TestSubcyclingCC_Initial AT initial
{
  LANG: C
  WRITES: state(interior) state_norestrict(interior)
  SYNC: state state_norestrict
} "Initialize scalar wave state"

SCHEDULE TestSubcyclingCC_Sync AT postregrid
{
  LANG: C
  OPTIONS: global
  SYNC: state state_norestrict
} "Synchronize"

SCHEDULE TestSubcyclingCC_Sync AT post_recover_variables
{
  LANG: C
  OPTIONS: global
  SYNC: state state_norestrict
} "Synchronize"

SCHEDULE TestSubcyclingCC_Sync IN ODESolvers_PostStep
{
  LANG: C
  OPTIONS: global
  SYNC: state state_norestrict
} "Synchronize"

SCHEDULE TestSubcyclingCC_RHS IN ODESolvers_RHS
{
  LANG: C
  READS: state(everywhere) state_norestrict(everywhere)
  WRITES: rhs(interior) rhs_norestrict(interior)
} "Calculate scalar wave RHS"

SCHEDULE TestSubcyclingCC_Error AT analysis
{
  LANG: C
  READS: state(interior)
  WRITES: error(interior)
  SYNC: error
} "Calculate error in scalar wave state"

# error is not checkpointed, and a level that lags its parent SYNCs it from
# the parent: recompute it after a restart, once the state's ghosts are
# refilled
SCHEDULE TestSubcyclingCC_Error AT post_recover_variables AFTER ODESolvers_PostStep
{
  LANG: C
  READS: state(interior)
  WRITES: error(interior)
  SYNC: error
} "Calculate error in scalar wave state"
