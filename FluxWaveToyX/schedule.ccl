# Schedule definitions for thorn FluxWaveToyX

STORAGE: state cons flux_x flux_y flux_z rhs energy error
STORAGE: mass mass_flux_x mass_flux_y mass_flux_z
STORAGE: prerestrict_energy

SCHEDULE FluxWaveToyX_Initial AT initial
{
  LANG: C
  WRITES: state(interior)
} "Initialize scalar wave state"

SCHEDULE FluxWaveToyX_Boundaries IN ODESolvers_PostStep
{
  LANG: C
  OPTIONS: global
  SYNC: state
} "Apply boundary conditions"

SCHEDULE FluxWaveToyX_Fluxes IN ODESolvers_RHS
{
  LANG: C
  READS: state(everywhere)
  WRITES: flux_x(interior)
  WRITES: flux_y(interior)
  WRITES: flux_z(interior)
} "Calculate scalar wave fluxes"

SCHEDULE FluxWaveToyX_RHS IN ODESolvers_RHS AFTER FluxWaveToyX_Fluxes
{
  LANG: C
  READS: state(interior)
  READS: flux_x(interior)
  READS: flux_y(interior)
  READS: flux_z(interior)
  WRITES: rhs(interior)
} "Calculate scalar wave RHS"

# The diagnostics are not checkpointed and are SYNCed under subcycling. They
# are computed at analysis and recomputed on every level after recovery: a
# checkpoint can land while the fine levels are behind the coarse ones, and
# the first post-recovery ANALYSIS may then run on fine levels only, whose
# SYNCs prolongate the diagnostics from a coarse level that has not run
# ANALYSIS yet.
SCHEDULE GROUP FluxWaveToyX_Diagnostics AT analysis
{
} "Compute diagnostics for output"

SCHEDULE GROUP FluxWaveToyX_Diagnostics IN CarpetX_RecomputeAfterRecovery AFTER ODESolvers_PostStep
{
} "Recompute diagnostics after recovery"

SCHEDULE FluxWaveToyX_Fluxes IN FluxWaveToyX_Diagnostics
{
  LANG: C
  READS: state(everywhere)
  WRITES: flux_x(interior)
  WRITES: flux_y(interior)
  WRITES: flux_z(interior)
  SYNC: flux_x flux_y flux_z
} "Calculate scalar wave fluxes for output"

SCHEDULE FluxWaveToyX_RHS IN FluxWaveToyX_Diagnostics AFTER FluxWaveToyX_Fluxes
{
  LANG: C
  READS: state(interior)
  READS: flux_x(interior)
  READS: flux_y(interior)
  READS: flux_z(interior)
  WRITES: rhs(interior)
  SYNC: rhs
} "Calculate scalar wave RHS for output"

SCHEDULE FluxWaveToyX_Constraints IN FluxWaveToyX_Diagnostics
{
  LANG: C
  READS: state(everywhere)
  WRITES: cons(interior)
  SYNC: cons
} "Calculate scalar wave constraints"

SCHEDULE FluxWaveToyX_Energy IN FluxWaveToyX_Diagnostics
{
  LANG: C
  READS: state(everywhere)
  WRITES: energy(interior)
  SYNC: energy
} "Calculate scalar wave energy density"

SCHEDULE FluxWaveToyX_Error IN FluxWaveToyX_Diagnostics
{
  LANG: C
  READS: state(interior)
  WRITES: error(interior)
  SYNC: error
} "Calculate error in scalar wave state"

# Fixture for the driver's flux-register bookkeeping: a flux-tagged group
# that is not integrated by ODESolvers, whose fluxes exist only after
# analysis (see interface.ccl).
SCHEDULE FluxWaveToyX_Mass IN FluxWaveToyX_Diagnostics
{
  LANG: C
  READS: state(everywhere)
  WRITES: mass(interior)
  WRITES: mass_flux_x(interior)
  WRITES: mass_flux_y(interior)
  WRITES: mass_flux_z(interior)
  SYNC: mass mass_flux_x mass_flux_y mass_flux_z
} "Calculate the conserved density and its fluxes for output"

# Fixture for the order of CarpetX_PreRestrict and the driver's reflux: when
# CarpetX_PreRestrict is traversed, the coarse level is not yet refluxed,
# and its ghosts agree with its interior. The average reaches across the
# state's full ghost width because the refluxed coarse cells (the cells just
# outside the refined box) lie up to ghost_size cells from the neighbouring
# coarse box's face in the standing_subcycling setup, so a narrower stencil
# would not read them. The snapshot is history that cannot be recomputed
# after recovery, so it is checkpointed (see interface.ccl).
SCHEDULE FluxWaveToyX_PreRestrictEnergy IN CarpetX_PreRestrict
{
  LANG: C
  READS: state(everywhere)
  WRITES: prerestrict_energy(interior)
  SYNC: prerestrict_energy
} "Average the energy density over the ghost width before restriction"

# Also write the snapshot at initial data, so that it is valid on every level
# and with every restriction mode (single level, restrict_during_sync = yes)
# before the first checkpoint, and is never checkpointed as poison. On
# multi-level runs without restrict_during_sync, CarpetX_PreRestrict at the end
# of initialisation overwrites it from the same state before any output.
# ODESolvers_PostStep has already SYNCed the state at this point.
SCHEDULE FluxWaveToyX_PreRestrictEnergy AT postinitial AFTER ODESolvers_PostStep
{
  LANG: C
  READS: state(everywhere)
  WRITES: prerestrict_energy(interior)
  SYNC: prerestrict_energy
} "Average the energy density over the ghost width at initial data"

# Recovery restores only the interior of the checkpointed snapshot; refill its
# ghosts once, over all levels.
SCHEDULE FluxWaveToyX_Boundaries AS FluxWaveToyX_SyncPreRestrict AT post_recover_variables
{
  LANG: C
  OPTIONS: global
  SYNC: prerestrict_energy
} "Refill the ghosts of the recovered pre-restrict energy"
