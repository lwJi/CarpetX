# Parameter definitions for thorn TestSubcyclingNoRestrict

CCTK_REAL amplitude "Initial amplitude"
{
  *:* :: ""
} 1.0

CCTK_REAL gaussian_width "width of Gaussian"
{
  (0:* :: ""
} 1.0

CCTK_REAL u_floor "Floor on u_nr: ODESolvers_PostStep sets u_nr = max(u_nr, u_floor) in the interior"
{
  *:* :: ""
} -1.0e+30
