ActiveThorns = "
    BoxInBox
    CarpetX
    CarpetXRegrid
    IOUtil
    TestRestrictTags
"

# Two levels without subcycling and with CarpetX::restrict_during_sync = no,
# so that the driver restricts only at the end of the step: the "end of
# step" column of the table in the README. The run stops after the initial
# data (cctk_itlast = 0), whose end-of-step restriction runs before
# CCTK_ANALYSIS. TestRestrictTags_Check aborts the run there unless the
# coarse interior under level 1 holds fine_value for exactly the groups in
# TestRestrictTags::restricted_groups: the two that the driver restricts by
# their tags, and nr_explicit, which the test restricts through the exported
# RestrictNoPoison although it is tagged restrict="no".

Cactus::cctk_show_schedule = no
Cactus::presync_mode = "mixed-error"
Cactus::cctk_itlast = 0

CarpetX::poison_undefined_values = yes
CarpetX::verbose = no

CarpetX::ncells_x = 16
CarpetX::ncells_y = 16
CarpetX::ncells_z = 16

CarpetX::periodic = yes

CarpetX::max_num_levels = 2
CarpetX::use_subcycling = no
CarpetX::restrict_during_sync = no

CarpetX::prolongation_type = "interpolate"
CarpetX::prolongation_order = 1

# A fixed cube at the origin; with BoxInBox's one-cell allowance for the cell
# that AMReX adds around the tagged region, level 1 covers exactly
# [-0.5, 0.5]^3. The run regrids only while it builds the initial levels.
BoxInBox::num_regions = 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = 2
BoxInBox::radius_1[1] = 0.5

TestRestrictTags::fine_box_radius = 0.5
TestRestrictTags::restricted_groups = "untagged ry_ckpt_no nr_explicit"

IO::out_dir = $parfile
IO::out_every = 1
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no
CarpetX::out_performance = no

CarpetX::out_norm_vars = "
    TestRestrictTags::untagged
    TestRestrictTags::ckpt_no
    TestRestrictTags::nr
    TestRestrictTags::nr_ckpt_no
    TestRestrictTags::ry_ckpt_no
    TestRestrictTags::nr_explicit
"
CarpetX::out_norm_omit_unstable = yes
CarpetX::out_norm_omit_sumloc_for_backward_compatibility = yes
