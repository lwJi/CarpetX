STORAGE: state rhs energy error

SCHEDULE VGFWaveToyX_Initial AT initial
{
  LANG: C
  WRITES: state(interior)
} "Initialize scalar wave state"

SCHEDULE VGFWaveToyX_Boundaries IN ODESolvers_PostStep
{
  LANG: C
  OPTIONS: global
  SYNC: state
} "Apply boundary conditions"

SCHEDULE VGFWaveToyX_RHS IN ODESolvers_RHS
{
  LANG: C
  READS: state(everywhere)
  WRITES: rhs(interior)
} "Calculate scalar wave RHS"

SCHEDULE GROUP VGFWaveToyX_Diagnostics AT analysis
{
} "Calculate scalar wave diagnostics"

SCHEDULE GROUP VGFWaveToyX_Diagnostics AT post_recover_variables AFTER ODESolvers_PostStep
{
} "Calculate scalar wave diagnostics"

SCHEDULE VGFWaveToyX_RHS IN VGFWaveToyX_Diagnostics
{
  LANG: C
  READS: state(everywhere)
  WRITES: rhs(interior)
  SYNC: rhs
} "Calculate scalar wave RHS (so that it can be output)"

SCHEDULE VGFWaveToyX_Energy IN VGFWaveToyX_Diagnostics
{
  LANG: C
  READS: state(everywhere)
  WRITES: energy(interior)
  SYNC: energy
} "Calculate scalar wave energy density"

SCHEDULE VGFWaveToyX_Error IN VGFWaveToyX_Diagnostics
{
  LANG: C
  READS: state(interior)
  WRITES: error(interior)
  SYNC: error
} "Calculate error in scalar wave state"
