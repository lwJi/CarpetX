# Checkpoint half of a checkpoint/recover pair for an evolved group with
# restriction disabled (TestSubcyclingNoRestrict::state_nr, see the README).
# The checkpoint is taken at iteration 6, where the three levels are at 2,
# 3/2 and 3/2 coarse steps: the clock groups are [0,1) and [1,3), and the
# finest one was restricted at its last end of step. There
# ProlongateRestrictedGFs overwrote level 2's coarse-fine ghosts of the
# restricted state, but state_nr kept the dense output from level 2's source
# bands, which the mid-cycle checkpoint carries. The run continues to
# iteration 8 as the uninterrupted baseline for recover-openpmd-midcycle.par.
#
# amplitude = -1 makes u decrease from zero, and u_floor = -0.01 clips u_nr
# at every step from the first one on around the finest level's coarse-fine
# boundary, so that level 1's state_nr differs there from the dense output
# its child's ghosts keep.

ActiveThorns = "
    BoxInBox
    CarpetX
    IOUtil
    ODESolvers
    TestSubcyclingNoRestrict
"

$out_every = 1
$nlevels = 3
$ncells = 32

TestSubcyclingNoRestrict::amplitude = -1.0
TestSubcyclingNoRestrict::gaussian_width = 0.17677669529 # sqrt(2)*W = 0.25
TestSubcyclingNoRestrict::u_floor = -0.01

CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no

CarpetX::poison_undefined_values = yes
CarpetX::verbose = no

Cactus::cctk_show_schedule = yes
Cactus::presync_mode = "mixed-error"

CarpetX::xmin = -4.0
CarpetX::ymin = -4.0
CarpetX::zmin = -4.0

CarpetX::xmax = +4.0
CarpetX::ymax = +4.0
CarpetX::zmax = +4.0

CarpetX::ncells_x = $ncells
CarpetX::ncells_y = $ncells
CarpetX::ncells_z = $ncells

Driver::periodic = "yes"
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes

CarpetX::max_num_levels = $nlevels
Driver::regrid_every = 128
Driver::regrid_error_threshold = 0.9

CarpetX::prolongation_type = "ddf"
CarpetX::ghost_size = 3
CarpetX::dtfac = 0.25

CarpetX::blocking_factor_x = 2
CarpetX::blocking_factor_y = 2
CarpetX::blocking_factor_z = 2

BoxInBox::num_regions = 1
# Region 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = $nlevels
BoxInBox::radius_1 = [ -1.0, 1.0, 0.5 ]

Cactus::terminate = "iteration"
Cactus::cctk_itlast = 8

ODESolvers::method = "RK4"

IO::out_dir = $parfile
IO::out_every = $out_every
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no

CarpetX::out_tsv_vars = "
    TestSubcyclingNoRestrict::state
    TestSubcyclingNoRestrict::state_nr
    TestSubcyclingNoRestrict::error
"

CarpetX::checkpoint_method = "openpmd"
IO::checkpoint_dir = $parfile + "/checkpoints"
IO::checkpoint_ID = no
IO::checkpoint_every = 6
IO::checkpoint_on_terminate = no
