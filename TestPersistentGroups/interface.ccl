IMPLEMENTS: TestPersistentGroups

USES INCLUDE HEADER: loop.hxx



CCTK_REAL persist_default TYPE=GF TAGS='checkpoint="yes"' "Time stamp, default-tagged (evolved by default)"
CCTK_REAL persist_noevolve TYPE=GF TAGS='checkpoint="yes" evolve="no"' "Time stamp, checkpointed but not evolved"

CCTK_INT stale_count TYPE=scalar TAGS='checkpoint="no"'
{
  stale_default
  stale_noevolve
} "Running total of stale points per tested group"

CCTK_INT stale_step TYPE=scalar TAGS='checkpoint="no"'
{
  stale_step_default
  stale_step_noevolve
} "Stale points per tested group in the current check pass"
