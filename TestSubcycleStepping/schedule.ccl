# Schedule definitions for thorn TestSubcycleStepping

STORAGE: iteration postrestrict prerestrict tail_context analysis_context
STORAGE: restricted_result recovery_counts step_counts

schedule TestSubcycleStepping_Init AT INITIAL
{
  LANG: C
  WRITES: iteration(interior)
  WRITES: postrestrict(interior)
  WRITES: prerestrict(interior)
  SYNC: iteration
  SYNC: postrestrict
  SYNC: prerestrict
} "initialize test grid functions"

schedule TestSubcycleStepping_Update AT EVOL
{
  LANG: C
  WRITES: iteration(interior)
  SYNC: iteration
} "update test grid function"

schedule TestSubcycleStepping_PostRestrict AT postrestrict
{
  LANG: C
  WRITES: postrestrict(interior)
  SYNC: postrestrict
} "stamp levels that see CCTK_POSTRESTRICT"

schedule TestSubcycleStepping_PreRestrict IN CarpetX_PreRestrict
{
  LANG: C
  WRITES: prerestrict(interior)
  SYNC: prerestrict
} "stamp levels that see CarpetX_PreRestrict"

schedule TestSubcycleStepping_Sync AT post_recover_variables
{
  LANG: C
  OPTIONS: global
  SYNC: iteration
  SYNC: postrestrict
  SYNC: prerestrict
} "restore the ghost zones, which checkpoints do not carry"



# tail_context: each level records the context of the last end-of-step window
# (CCTK_POSTSTEP) that covered it, and after a restart the context of the
# CCTK_POST_RECOVER_VARIABLES traversal that covered it. analysis_context does
# the same for CCTK_ANALYSIS. Both copy "postrestrict" as a canary, which
# shows that the window came after that iteration's CCTK_POSTRESTRICT. Under
# subcycling both are end-of-step results, so mid-step levels hold them as
# invalid, during evolution and after a restart alike.

schedule TestSubcycleStepping_StampTail AT poststep
{
  LANG: C
  READS: postrestrict(everywhere)
  WRITES: tail_context(everywhere)
} "stamp the levels of an end-of-step window with its context"

schedule TestSubcycleStepping_StampTail AT post_recover_variables AFTER TestSubcycleStepping_Sync
{
  LANG: C
  READS: postrestrict(everywhere)
  WRITES: tail_context(everywhere)
} "stamp the levels of a recovery traversal with its context"

schedule TestSubcycleStepping_StampAnalysis AT analysis
{
  LANG: C
  READS: postrestrict(everywhere)
  WRITES: analysis_context(everywhere)
} "stamp the levels of an analysis window with its context"

schedule TestSubcycleStepping_StampAnalysis AT post_recover_variables AFTER TestSubcycleStepping_Sync
{
  LANG: C
  READS: postrestrict(everywhere)
  WRITES: analysis_context(everywhere)
} "stamp the levels of a recovery traversal with its context"



# restricted_result: an end-of-step result tagged restrict="yes"
# (interface.ccl). Under subcycling a run with two or more levels completes
# only if the driver's restrictions leave it out.

schedule TestSubcycleStepping_StampRestricted AT initial
{
  LANG: C
  WRITES: restricted_result(everywhere)
} "stamp the restricted end-of-step result after the initial data"

schedule TestSubcycleStepping_StampRestricted AT analysis
{
  LANG: C
  WRITES: restricted_result(everywhere)
} "stamp the restricted end-of-step result at the end of step"



# step_counts: count every traversal of CCTK_POSTSTEP and CCTK_ANALYSIS. With
# subcycling each runs once per cctk_iteration, plus once after the initial
# data, so after iteration n of a fresh run both counts are n + 1. One routine
# per bin, since a routine cannot tell which bin calls it.

schedule TestSubcycleStepping_CountStepPostStep AT poststep
{
  LANG: C
  OPTIONS: global
  READS: step_counts
  WRITES: step_counts
} "count traversals of CCTK_POSTSTEP"

schedule TestSubcycleStepping_CountStepAnalysis AT analysis
{
  LANG: C
  OPTIONS: global
  READS: step_counts
  WRITES: step_counts
} "count traversals of CCTK_ANALYSIS"



# recovery_counts: count the traversals of each bin from
# CCTK_RECOVER_VARIABLES until CCTK_CPINITIAL, so that the first output after
# a restart shows which bins recovery ran. A fresh start zeroes the counts
# with counting off, so that they stay 0. One routine per bin, since a routine
# cannot tell which bin calls it. Both also zero step_counts.

schedule TestSubcycleStepping_ResetCounts AT initial
{
  LANG: C
  OPTIONS: global
  WRITES: recovery_counts
  WRITES: step_counts
} "zero the recovery counts, with counting off"

schedule TestSubcycleStepping_StartCounting AT recover_variables
{
  LANG: C
  OPTIONS: global
  WRITES: recovery_counts
  WRITES: step_counts
} "zero the recovery counts and start counting"

schedule TestSubcycleStepping_StopCounting AT cpinitial
{
  LANG: C
  OPTIONS: global
  READS: recovery_counts
  WRITES: recovery_counts
} "stop counting, freezing the counts of what recovery ran"

schedule TestSubcycleStepping_CountPostRecover AT post_recover_variables
{
  LANG: C
  OPTIONS: global
  READS: recovery_counts
  WRITES: recovery_counts
} "count traversals of CCTK_POST_RECOVER_VARIABLES"

schedule TestSubcycleStepping_CountPostStep AT poststep
{
  LANG: C
  OPTIONS: global
  READS: recovery_counts
  WRITES: recovery_counts
} "count traversals of CCTK_POSTSTEP"

schedule TestSubcycleStepping_CountAnalysis AT analysis
{
  LANG: C
  OPTIONS: global
  READS: recovery_counts
  WRITES: recovery_counts
} "count traversals of CCTK_ANALYSIS"

schedule TestSubcycleStepping_CountPreRestrict IN CarpetX_PreRestrict
{
  LANG: C
  OPTIONS: global
  READS: recovery_counts
  WRITES: recovery_counts
} "count traversals of CarpetX_PreRestrict"

schedule TestSubcycleStepping_CountPostRestrict AT postrestrict
{
  LANG: C
  OPTIONS: global
  READS: recovery_counts
  WRITES: recovery_counts
} "count traversals of CCTK_POSTRESTRICT"
