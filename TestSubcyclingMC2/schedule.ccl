# Schedule definitions for thorn TestSubcyclingMC2

STORAGE: state[timelevels] rhs error


# Each level's error estimate must see the box position at that level's own
# time: move the box before every error estimate, including the one after a
# restart, which recomputes each level's estimate as at the end of its last
# step
SCHEDULE GROUP TestSubcyclingMC2_UpdateBoxes AT postinitial BEFORE EstimateError
{
} "Move the refined box along a linear drift from the origin"

SCHEDULE GROUP TestSubcyclingMC2_UpdateBoxes AT poststep BEFORE EstimateError
{
} "Move the refined box along a linear drift from the origin"

SCHEDULE GROUP TestSubcyclingMC2_UpdateBoxes AT post_recover_variables BEFORE EstimateError
{
} "Move the refined box along a linear drift from the origin"

SCHEDULE TestSubcyclingMC2_MoveBox IN TestSubcyclingMC2_UpdateBoxes
{
  LANG: C
  READS: BoxInBox::positions
  WRITES: BoxInBox::positions
} "Move the refined box along a linear drift from the origin"

# The next regrid reads num_levels: after a restart, each level's error
# estimate must see the value of that level's own iteration, as at the end of
# its last step
SCHEDULE GROUP TestSubcyclingMC2_UpdateLevels AT poststep BEFORE EstimateError
{
} "Ask for one more refinement level from add_level_at_iteration on"

SCHEDULE GROUP TestSubcyclingMC2_UpdateLevels AT post_recover_variables BEFORE EstimateError
{
} "Ask for one more refinement level from add_level_at_iteration on"

SCHEDULE TestSubcyclingMC2_AddLevel IN TestSubcyclingMC2_UpdateLevels
{
  LANG: C
  OPTIONS: global
  READS: BoxInBox::num_levels
  WRITES: BoxInBox::num_levels
} "Ask for one more refinement level from add_level_at_iteration on"

SCHEDULE TestSubcyclingMC2_Initial AT initial
{
  LANG: C
  WRITES: state(interior)
  SYNC: state
} "Initialize scalar wave state"

SCHEDULE TestSubcyclingMC2_Probe AT PostInitial
{
  LANG: C
  OPTIONS: global
} "Verify STORAGE registry matches schedule.ccl"

SCHEDULE TestSubcyclingMC2_Sync AT postregrid
{
  LANG: C
  OPTIONS: global
  SYNC: state
} "Synchronize"

SCHEDULE TestSubcyclingMC2_Sync AT post_recover_variables
{
  LANG: C
  OPTIONS: global
  SYNC: state
} "Synchronize"

SCHEDULE TestSubcyclingMC2_Sync IN ODESolvers_PostStep
{
  LANG: C
  OPTIONS: global
  SYNC: state
} "Synchronize"

SCHEDULE TestSubcyclingMC2_RHS IN ODESolvers_RHS
{
  LANG: C
  READS: state(everywhere)
  WRITES: rhs(interior)
} "Calculate scalar wave RHS"

# error is not checkpointed, and a level that lags its parent SYNCs it from
# the parent: compute it at the end of each step, and again after a restart,
# once the state's ghosts are refilled
SCHEDULE GROUP TestSubcyclingMC2_Diagnostics AT analysis
{
} "Calculate scalar wave diagnostics"

SCHEDULE GROUP TestSubcyclingMC2_Diagnostics AT post_recover_variables AFTER ODESolvers_PostStep
{
} "Calculate scalar wave diagnostics"

SCHEDULE TestSubcyclingMC2_Error IN TestSubcyclingMC2_Diagnostics
{
  LANG: C
  READS: state(interior)
  WRITES: error(interior)
  SYNC: error
} "Calculate error in scalar wave state"
