ActiveThorns = "
    CarpetX
    CarpetXRegrid
    FluxWaveToyX
    IOUtil
    ODESolvers
"

# Second half of the initial-data checkpoint/recover pair for the
# single-level standing wave (standing.par). Recovers from the checked-in
# iteration-0 checkpoint written at CPINITIAL by checkpoint_initial.par and
# continues to the same final iteration. The checkpointed prerestrict_energy
# was written at POSTINITIAL, so recovery reads defined values and the first
# step's validity check passes. Unlike the other recover pars this one keeps
# out_initial_data, so the recovered iteration 0 is output too: every output
# of this run is bit-identical to checkpoint_initial's.

Cactus::cctk_show_schedule = no
Cactus::presync_mode = "mixed-error"

CarpetX::poison_undefined_values = yes

CarpetX::ncells_x = 8
CarpetX::ncells_y = 8
CarpetX::ncells_z = 8

Driver::periodic = "yes"
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes

# Same final iteration as checkpoint_initial.par
Cactus::cctk_itlast = 4

FluxWaveToyX::initial_condition = "standing wave"

ODESolvers::method = "RK3"

IO::out_dir = $parfile
IO::out_every = 1
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no
CarpetX::out_performance = no
# Pins the recovered iteration 0
CarpetX::out_initial_data = yes

CarpetX::out_norm_vars = "
    FluxWaveToyX::state
    FluxWaveToyX::error
    FluxWaveToyX::prerestrict_energy
"
CarpetX::out_norm_omit_unstable = yes
CarpetX::out_norm_omit_sumloc_for_backward_compatibility = yes

# Recovery restores only the interior of a checkpointed group, and nothing
# reads prerestrict_energy's ghosts, so they are not refilled: output
# interior points only
CarpetX::out_tsv_output_boundary_points = no
CarpetX::out_tsv_every = 4
CarpetX::out_tsv_vars = "
    FluxWaveToyX::state
    FluxWaveToyX::error
    FluxWaveToyX::prerestrict_energy
"

IO::checkpoint_dir = $parfile
IO::checkpoint_ID = no
IO::checkpoint_every = 0
IO::checkpoint_on_terminate = no

CarpetX::recover_method = "openpmd"
IO::recover_dir = "../../../arrangements/CarpetX/FluxWaveToyX/test/checkpoints_initial"
IO::recover = "autoprobe"
