# Checkpoint half of a time-aligned checkpoint/recover pair for an evolved
# group with restriction disabled (TestSubcyclingNoRestrict::state_nr). The
# checkpoint is taken at iteration 4, where the three levels are all at 1
# coarse step: the single clock group [0,3) was restricted at its last end
# of step. There ProlongateAfterRestriction overwrote the coarse-fine ghosts
# of levels 1 and 2 by prolongation from their parents, for the restricted
# state and for state_nr alike. The checkpoint is time-aligned and so
# carries no source bands. The run continues to iteration 6 as the
# uninterrupted baseline for recover-openpmd-aligned.par.
#
# amplitude = -1 makes u decrease from zero, and u_floor = -0.01 clips u_nr
# at every step from the first one on around the refined levels' coarse-fine
# boundaries, so that the parents' state_nr differs there from the dense
# output that their children's ghosts held before that prolongation.

ActiveThorns = "
    BoxInBox
    CarpetX
    IOUtil
    ODESolvers
    TestSubcyclingNoRestrict
"

$out_every = 1
$nlevels = 3
$ncells = 32

TestSubcyclingNoRestrict::amplitude = -1.0
TestSubcyclingNoRestrict::gaussian_width = 0.17677669529 # sqrt(2)*W = 0.25
TestSubcyclingNoRestrict::u_floor = -0.01

CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no

CarpetX::poison_undefined_values = yes
CarpetX::verbose = no

Cactus::cctk_show_schedule = yes
Cactus::presync_mode = "mixed-error"

CarpetX::xmin = -4.0
CarpetX::ymin = -4.0
CarpetX::zmin = -4.0

CarpetX::xmax = +4.0
CarpetX::ymax = +4.0
CarpetX::zmax = +4.0

CarpetX::ncells_x = $ncells
CarpetX::ncells_y = $ncells
CarpetX::ncells_z = $ncells

Driver::periodic = "yes"
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes

CarpetX::max_num_levels = $nlevels
Driver::regrid_every = 128
Driver::regrid_error_threshold = 0.9

CarpetX::prolongation_type = "ddf"
CarpetX::ghost_size = 3
CarpetX::dtfac = 0.25

CarpetX::blocking_factor_x = 2
CarpetX::blocking_factor_y = 2
CarpetX::blocking_factor_z = 2

BoxInBox::num_regions = 1
# Region 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = $nlevels
BoxInBox::radius_1 = [ -1.0, 1.0, 0.5 ]

Cactus::terminate = "iteration"
Cactus::cctk_itlast = 6

ODESolvers::method = "RK4"

IO::out_dir = $parfile
IO::out_every = $out_every
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no

CarpetX::out_tsv_vars = "
    TestSubcyclingNoRestrict::state
    TestSubcyclingNoRestrict::state_nr
    TestSubcyclingNoRestrict::error
"

CarpetX::checkpoint_method = "openpmd"
IO::checkpoint_dir = $parfile + "/checkpoints"
IO::checkpoint_ID = no
IO::checkpoint_every = 4
IO::checkpoint_on_terminate = no
