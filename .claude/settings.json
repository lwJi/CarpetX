{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$CLAUDE_PROJECT_DIR/scripts/lint\"; [ -f \"$d/__main__.py\" ] || exit 0; python3 \"$d\" hook-edit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$CLAUDE_PROJECT_DIR/scripts/lint\"; [ -f \"$d/__main__.py\" ] || exit 0; python3 \"$d\" hook-stop"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$CLAUDE_PROJECT_DIR/scripts/lint\"; [ -f \"$d/__main__.py\" ] || exit 0; python3 \"$d\" hook-stop"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { IFS= read -r file_path; if [ -n \"$file_path\" ] && echo \"$file_path\" | grep -qE '\\.(c|cpp|cc|cxx|h|hpp|hxx)$'; then clang-format -i -- \"$file_path\"; fi; }"
          }
        ]
      }
    ]
  }
}
