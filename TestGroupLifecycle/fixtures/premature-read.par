# ODESolvers is deliberately inactive: evolve="yes" still invalidates tl=0.
ActiveThorns = "CarpetX IOUtil TestGroupLifecycle"

TestGroupLifecycle::premature_read = yes
Cactus::terminate = "iteration"
Cactus::cctk_itlast = 1
Cactus::presync_mode = "mixed-error"

CarpetX::ncells_x = 8
CarpetX::ncells_y = 8
CarpetX::ncells_z = 8
CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1
CarpetX::max_num_levels = 1
CarpetX::poison_undefined_values = yes

IO::out_dir = $parfile
IO::parfile_write = no
CarpetX::out_metadata = no
