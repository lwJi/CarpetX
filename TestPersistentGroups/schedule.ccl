# Schedule definitions for thorn TestPersistentGroups

STORAGE: persist_default persist_noevolve stale_count stale_step

if (test_history) {
  STORAGE: persistent_history[2] history_checks

  SCHEDULE TestPersistentGroups_HistoryZero AT initial
  {
    LANG: C
    OPTIONS: global
    WRITES: history_checks
  } "Reset successful history checks"

  SCHEDULE TestPersistentGroups_HistoryInit AT initial AFTER TestPersistentGroups_Init
  {
    LANG: C
    WRITES: persistent_history(everywhere)
    WRITES: persistent_history_p(everywhere)
  } "Initialize both timelevels of the persistent diagnostic"

  SCHEDULE TestPersistentGroups_HistoryRead AT evol BEFORE TestPersistentGroups_Write
  {
    LANG: C
    READS: persist_default(interior)
    READS: persistent_history(everywhere)
    READS: persistent_history_p(everywhere)
  } "Check the seeded current timelevel before the diagnostic is updated"

  SCHEDULE TestPersistentGroups_HistoryUpdate AT evol AFTER TestPersistentGroups_Write
  {
    LANG: C
    READS: persist_default(interior)
    READS: persistent_history(everywhere)
    READS: persistent_history_p(everywhere)
    WRITES: persistent_history(everywhere)
  } "Occasionally update the diagnostic and check that its history is untouched"

  SCHEDULE TestPersistentGroups_HistoryRegrid AT postregrid
  {
    LANG: C
    READS: persist_default(interior)
    READS: persistent_history(everywhere)
    READS: persistent_history_p(everywhere)
  } "Check both timelevels before any postregrid rewrite"

  SCHEDULE TestPersistentGroups_HistoryZero AT post_recover_variables
  {
    LANG: C
    OPTIONS: global
    WRITES: history_checks
  } "Reset successful history checks after recovery"

  SCHEDULE TestPersistentGroups_HistoryRecover AT post_recover_variables AFTER TestPersistentGroups_HistoryZero
  {
    LANG: C
    READS: persist_default(interior)
    READS: persistent_history(interior)
    READS: persistent_history_p(interior)
    # The interiors are checked and retained; restoring the omitted points
    # makes both complete timelevels valid on return.
    WRITES: persistent_history(everywhere)
    WRITES: persistent_history_p(everywhere)
  } "Check recovered history interiors and restore only their omitted ghosts"

  SCHEDULE TestPersistentGroups_HistorySummary AT analysis
  {
    LANG: C
    OPTIONS: global
    WRITES: history_checks
  } "Publish the successful history checks"

  SCHEDULE TestPersistentGroups_HistoryDone AT terminate
  {
    LANG: C
    OPTIONS: global
    READS: history_checks
  } "Require cycling, updates, moving regrid, and requested recovery coverage"
}



# Initial data: stamp 0 everywhere, start the running total, check

SCHEDULE TestPersistentGroups_Init AT initial
{
  LANG: C
  WRITES: persist_default(interior)
  WRITES: persist_noevolve(interior)
  SYNC: persist_default
  SYNC: persist_noevolve
} "Stamp the tested groups with the initial time"

SCHEDULE TestPersistentGroups_Zero AT initial AFTER TestPersistentGroups_Init
{
  LANG: C
  OPTIONS: global
  WRITES: stale_count
} "Reset the running total of stale points"

SCHEDULE GROUP TestPersistentGroups_CheckGroup AT initial AFTER (TestPersistentGroups_Init, TestPersistentGroups_Zero)
{
} "Count stale points in the tested groups"



# Evolution: after the integrated state has been advanced, stamp the level's
# new time on the interior, SYNC, and check every point including the ghosts

SCHEDULE TestPersistentGroups_Write AT evol AFTER (ODESolvers_Solve, ODESolvers_Solve_Subcycling)
{
  LANG: C
  WRITES: persist_default(interior)
  WRITES: persist_noevolve(interior)
  SYNC: persist_default
  SYNC: persist_noevolve
} "Stamp the tested groups with the level's current time"

SCHEDULE GROUP TestPersistentGroups_CheckGroup AT evol AFTER TestPersistentGroups_Write
{
} "Count stale points in the tested groups"



# Regridding: the stamps must survive (levels are time-aligned at a regrid)

SCHEDULE GROUP TestPersistentGroups_CheckGroup AT postregrid
{
} "Count stale points in the tested groups"



# Recovery: checkpoints carry the interior only, so restore the ghosts with a
# SYNC (as MHD_Diagnostics::vels_old and TestSubcycleStepping do), restart the
# running total (it is not checkpointed), and check that the recovered stamps
# are intact

SCHEDULE TestPersistentGroups_Sync AT post_recover_variables
{
  LANG: C
  OPTIONS: global
  SYNC: persist_default
  SYNC: persist_noevolve
} "Restore the ghosts of the tested groups, which checkpoints do not carry"

SCHEDULE TestPersistentGroups_Zero AT post_recover_variables AFTER TestPersistentGroups_Sync
{
  LANG: C
  OPTIONS: global
  WRITES: stale_count
} "Reset the running total of stale points"

SCHEDULE GROUP TestPersistentGroups_CheckGroup AT post_recover_variables AFTER (TestPersistentGroups_Sync, TestPersistentGroups_Zero)
{
} "Count stale points in the tested groups"



# The check pass

SCHEDULE TestPersistentGroups_ZeroStep IN TestPersistentGroups_CheckGroup
{
  LANG: C
  OPTIONS: global
  WRITES: stale_step
} "Reset the per-pass stale counts"

SCHEDULE TestPersistentGroups_Check IN TestPersistentGroups_CheckGroup AFTER TestPersistentGroups_ZeroStep
{
  LANG: C
  READS: persist_default(everywhere)
  READS: persist_noevolve(everywhere)
} "Count points that hold neither the level's nor the parent's stamp"

SCHEDULE TestPersistentGroups_Reduce IN TestPersistentGroups_CheckGroup AFTER TestPersistentGroups_Check
{
  LANG: C
  OPTIONS: global
  READS: stale_count
  WRITES: stale_count
  WRITES: stale_step
} "Sum the per-pass stale counts over ranks, warn, and add them to the running total"
