# Old-format compatibility test: recovers a frozen checkpoint that predates
# per-level end-of-step iterations (last_tail_iteration) and whose levels are
# on three clocks. CarpetX 877429fc (dev, which predates last_tail_iteration)
# wrote it from the setup of checkpoint-subcycling-openpmd-4clocks.par at
# iteration 3, where the four levels are at 1, 1/2, 1/2 and 3/8 coarse steps.
# Recovery derives the missing values from the clocks and warns: level 0 last
# ran its end of step at iteration 1, levels 1 to 3 at iteration 3.
#
# For iterations 4 to 8, state must equal the uninterrupted run's bit for
# bit, and error and tail_context must match it too (the uninterrupted run is
# checkpoint-subcycling-openpmd-4clocks.par, which shares iterations 4 and 8
# with this test). At iteration 4 level 0 still holds the derived context of
# its recovery traversal (iteration 1, time cctk_delta_time, timefac 1); at
# iteration 5 it joins level 1's end-of-step window. recovery_counts records
# three POST_RECOVER_VARIABLES traversals, one per clock group, and no
# POSTSTEP, ANALYSIS, CarpetX_PreRestrict or POSTRESTRICT.
#
# The checkpoint is written on 1 rank; the testsuite also recovers it on 2.

ActiveThorns = "
    BoxInBox
    CarpetX
    IOUtil
    ODESolvers
    TestSubcycleStepping
    TestSubcyclingMC2
"

$out_every = 1
$nlevels = 4
$ncells = 32

TestSubcyclingMC2::initial_condition = "Gaussian"
TestSubcyclingMC2::gaussian_width = 0.17677669529 # sqrt(2)*W = 0.25

CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no

CarpetX::poison_undefined_values = yes
CarpetX::verbose = no

Cactus::cctk_show_schedule = yes
Cactus::presync_mode = "mixed-error"

CarpetX::xmin = -4.0
CarpetX::ymin = -4.0
CarpetX::zmin = -4.0

CarpetX::xmax = +4.0
CarpetX::ymax = +4.0
CarpetX::zmax = +4.0

CarpetX::ncells_x = $ncells
CarpetX::ncells_y = $ncells
CarpetX::ncells_z = $ncells

Driver::periodic = "yes"
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes

CarpetX::max_num_levels = $nlevels
Driver::regrid_every = 128
Driver::regrid_error_threshold = 0.9

CarpetX::prolongation_type = "ddf"
#CarpetX::prolongation_order = 5
CarpetX::ghost_size = 3
CarpetX::dtfac = 0.25

CarpetX::blocking_factor_x = 2
CarpetX::blocking_factor_y = 2
CarpetX::blocking_factor_z = 2
#CarpetX::max_grid_size_x = 10000000
#CarpetX::max_grid_size_y = 10000000
#CarpetX::max_grid_size_z = 10000000
#CarpetX::max_tile_size_x = 10000000
#CarpetX::max_tile_size_y = 10000000
#CarpetX::max_tile_size_z = 10000000

BoxInBox::num_regions = 1
# Region 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = $nlevels
BoxInBox::radius_1 = [ -1.0, 1.0, 0.5, 0.25 ]

Cactus::terminate = "iteration"
#Cactus::cctk_final_time = 2.0
Cactus::cctk_itlast = 8

ODESolvers::method = "RK4"
#ODESolvers::verbose = yes

IO::out_dir = $parfile
IO::out_every = $out_every
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no
CarpetX::out_initial_data = no

CarpetX::out_tsv_vars = "
    TestSubcyclingMC2::state
    TestSubcyclingMC2::error
    TestSubcycleStepping::tail_context
    TestSubcycleStepping::recovery_counts
"

IO::checkpoint_dir = $parfile
IO::checkpoint_ID = no
IO::checkpoint_every = 0
IO::checkpoint_on_terminate = no

CarpetX::recover_method = "openpmd"
IO::recover_dir = "../../../arrangements/CarpetX/TestSubcyclingMC2/test/checkpoints-subcycling-openpmd-oldformat-3clocks"
IO::recover = "autoprobe"
