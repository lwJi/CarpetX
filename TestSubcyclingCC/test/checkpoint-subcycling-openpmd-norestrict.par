# Checkpoint half of a checkpoint/recover pair for a group that the driver
# does not restrict (state_norestrict, restrict="no"), on the gaussian_eno
# setup cut short. The checkpoint is taken at iteration 4, where the three
# levels are time-aligned again, so it carries no RK source bands: the
# driver has just restricted the window [0,3) and refilled the coarse-fine
# ghosts of levels 1 and 2 by spatial prolongation from their parents, for
# state_norestrict as for state. The run continues to iteration 8, where
# the levels are aligned again, as the uninterrupted baseline for
# recover-subcycling-openpmd-norestrict.par.

ActiveThorns = "
    BoxInBox
    CarpetX
    IOUtil
    ODESolvers
    TestSubcyclingCC
"

$out_every = 1
$nlevels = 3
$ncells = 32

TestSubcyclingCC::gaussian_width = 0.17677669529 # sqrt(2)*W = 0.25

CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no

CarpetX::poison_undefined_values = yes
CarpetX::verbose = no

Cactus::cctk_show_schedule = yes
Cactus::presync_mode = "mixed-error"

# The domain is shifted by a different, generic amount in each direction
# so that no cell centre is mirrored about the pulse at the origin and no
# two axes are interchangeable. The ENO stencil selection compares
# undivided differences of candidate stencils; on a symmetric grid these
# tie exactly and the tie is broken by platform-dependent rounding, which
# makes the reference output compiler-specific. The offsets are not
# multiples of half the cell spacing on any level (0.125, 0.0625, 0.03125).
CarpetX::xmin = -4.0371
CarpetX::ymin = -4.0193
CarpetX::zmin = -4.0117

CarpetX::xmax = +3.9629
CarpetX::ymax = +3.9807
CarpetX::zmax = +3.9883

CarpetX::ncells_x = $ncells
CarpetX::ncells_y = $ncells
CarpetX::ncells_z = $ncells

Driver::periodic = "yes"
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes

CarpetX::max_num_levels = $nlevels
Driver::regrid_every = 128
Driver::regrid_error_threshold = 0.9

CarpetX::prolongation_type = "eno"
CarpetX::prolongation_order = 3
CarpetX::ghost_size = 3
CarpetX::dtfac = 0.25

CarpetX::blocking_factor_x = 2
CarpetX::blocking_factor_y = 2
CarpetX::blocking_factor_z = 2

BoxInBox::num_regions = 1
# Region 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = $nlevels
BoxInBox::radius_1 = [ -1.0, 1.0, 0.5 ]


Cactus::terminate = "iteration"
Cactus::cctk_itlast = 8

ODESolvers::method = "RK4"

IO::out_dir = $parfile
IO::out_every = $out_every
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no
CarpetX::out_tsv_vars = "
    TestSubcyclingCC::state
    TestSubcyclingCC::state_norestrict
"

CarpetX::checkpoint_method = "openpmd"
IO::checkpoint_dir = $parfile + "/checkpoints"
IO::checkpoint_ID = no
IO::checkpoint_every = 4
IO::checkpoint_on_terminate = no
