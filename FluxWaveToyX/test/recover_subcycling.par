ActiveThorns = "
    BoxInBox
    CarpetX
    CarpetXRegrid
    FluxWaveToyX
    IOUtil
    ODESolvers
"

# Second half of the mid-cycle checkpoint/recover pair for the subcycled
# two-level standing wave (standing_subcycling.par). Recovers from the
# checked-in iteration-7 checkpoint written by checkpoint_subcycling.par,
# where the fine level is half a coarse step behind its parent, and
# continues to iteration 16. Recovery restores the coarse RK source bands
# and the partially accumulated flux register of the pair (0, 1), so the
# first reflux after recovery repays the same mismatch the uninterrupted run
# does: every output of this run is bit-identical to standing_subcycling's
# at the shared iterations, and the masked sums of ft, fx, fy, fz stay
# constant to round-off across the recovery point.

Cactus::cctk_show_schedule = no
Cactus::presync_mode = "mixed-error"

CarpetX::poison_undefined_values = yes
CarpetX::verbose = no

CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0

CarpetX::xmax = +1.0
CarpetX::ymax = +1.0
CarpetX::zmax = +1.0

CarpetX::ncells_x = 16
CarpetX::ncells_y = 16
CarpetX::ncells_z = 16

Driver::periodic = "yes"
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes

CarpetX::max_num_levels = 2
Driver::regrid_every = 128000
Driver::regrid_error_threshold = 0.9

CarpetX::prolongation_type = "ddf"
CarpetX::ghost_size = 3
CarpetX::dtfac = 0.25

CarpetX::blocking_factor_x = 2
CarpetX::blocking_factor_y = 2
CarpetX::blocking_factor_z = 2
CarpetX::max_grid_size_x = 8
CarpetX::max_grid_size_y = 8
CarpetX::max_grid_size_z = 8

CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no

BoxInBox::num_regions = 1
# Region 1: the same fixed, off-centre cube as standing_subcycling.par
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = 2
BoxInBox::position_x_1 = 0.25
BoxInBox::position_y_1 = -0.125
BoxInBox::position_z_1 = 0.125
BoxInBox::radius_1 = [ -1.0, 0.5 ]

# Same final iteration as standing_subcycling.par
Cactus::cctk_itlast = 16

FluxWaveToyX::initial_condition = "standing wave"

ODESolvers::method = "SSPRK3"

IO::out_dir = $parfile
IO::out_every = 1
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no
CarpetX::out_performance = no
CarpetX::out_initial_data = no

CarpetX::out_norm_vars = "FluxWaveToyX::state"
CarpetX::out_norm_omit_unstable = yes
CarpetX::out_norm_omit_sumloc_for_backward_compatibility = yes

CarpetX::out_tsv_every = 16
CarpetX::out_tsv_vars = "
    FluxWaveToyX::state
    FluxWaveToyX::error
"

IO::checkpoint_dir = $parfile
IO::checkpoint_ID = no
IO::checkpoint_every = 0
IO::checkpoint_on_terminate = no

CarpetX::recover_method = "openpmd"
IO::recover_dir = "../../../arrangements/CarpetX/FluxWaveToyX/test/checkpoints_subcycling"
IO::recover = "autoprobe"
