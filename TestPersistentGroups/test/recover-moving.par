# Old-format compatibility test: the frozen checkpoint predates per-level
# end-of-step iterations (last_tail_iteration). Its levels are on two
# clocks, so recovery derives the missing values from the clocks and warns.
# See "Recovery" in the CarpetX documentation.

# Recover half of a checkpoint/recover pair on the moving.par setup (see
# there and checkpoint-moving.par): recovers the mid-cycle checkpoint taken at
# iteration 6 (refined levels out of step with level 0, after the regrid at 4)
# and continues through the regrids at iterations 8 and 12.
#
# At RECOVER_VARIABLES TestPersistentGroups restarts the running total. At
# POST_RECOVER_VARIABLES it SYNCs the tested groups (checkpoints carry their
# interior only) and checks that the recovered stamps are intact. The rows at
# iterations 8 and 16 hold the same stamps as moving.par's. The correct value
# of stale_count is 0 for both groups in every row.

ActiveThorns = "
    BoxInBox
    CarpetX
    IOUtil
    ODESolvers
    TestPersistentGroups
    TestSubcyclingMC2
"

$out_every = 8
$nlevels = 3
$ncells = 32

TestSubcyclingMC2::initial_condition = "Gaussian"
TestSubcyclingMC2::gaussian_width = 0.17677669529 # sqrt(2)*W = 0.25

# Drift the refined box along +x so that level-1 (and level-2) grids change at
# each regrid
TestSubcyclingMC2::box_velocity_x = 2.0

CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no

CarpetX::poison_undefined_values = yes
CarpetX::verbose = no

Cactus::cctk_show_schedule = yes
Cactus::presync_mode = "mixed-error"

CarpetX::xmin = -4.0
CarpetX::ymin = -4.0
CarpetX::zmin = -4.0

CarpetX::xmax = +4.0
CarpetX::ymax = +4.0
CarpetX::zmax = +4.0

CarpetX::ncells_x = $ncells
CarpetX::ncells_y = $ncells
CarpetX::ncells_z = $ncells

Driver::periodic = "yes"
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes

CarpetX::max_num_levels = $nlevels
Driver::regrid_every = 4
Driver::regrid_error_threshold = 0.9

CarpetX::prolongation_type = "ddf"
CarpetX::ghost_size = 3
CarpetX::dtfac = 0.25

CarpetX::blocking_factor_x = 2
CarpetX::blocking_factor_y = 2
CarpetX::blocking_factor_z = 2

BoxInBox::num_regions = 1
# Region 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = $nlevels
BoxInBox::radius_1 = [ -1.0, 1.0, 0.5 ]

Cactus::terminate = "iteration"
Cactus::cctk_itlast = 16

ODESolvers::method = "RK4"

IO::out_dir = $parfile
IO::out_every = $out_every
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no
CarpetX::out_initial_data = no

CarpetX::out_tsv_vars = "
    TestPersistentGroups::stale_count
    TestPersistentGroups::persist_default
    TestPersistentGroups::persist_noevolve
"

IO::checkpoint_dir = $parfile
IO::checkpoint_ID = no
IO::checkpoint_every = 0
IO::checkpoint_on_terminate = no

CarpetX::recover_method = "openpmd"
IO::recover_dir = "../../../arrangements/CarpetX/TestPersistentGroups/test/checkpoints-moving"
IO::recover = "autoprobe"
