SRCS =							\
	binding.cxx					\
	grid.cxx					\
	grid_sizes.cxx					\
	group_tags.cxx					\
	handles.cxx					\
	hierarchy.cxx					\
	integrator.cxx					\
	loops.cxx					\
	modes.cxx					\
	rk_levels.cxx					\
	valid.cxx					\
	why_valid.cxx					\
	yaml.cxx

STRAY_DIR := $(dir $(lastword $(MAKEFILE_LIST)))
STRAY_SRCS := $(filter-out $(SRCS),$(notdir $(wildcard $(STRAY_DIR)*.cxx)))
ifneq ($(STRAY_SRCS),)
$(error CarpetX/src/$(notdir $(STRAY_DIR:/=))/make.code.defn: not in SRCS: $(STRAY_SRCS))
endif
