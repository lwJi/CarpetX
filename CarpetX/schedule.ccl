# Schedule definitions for thorn CarpetX



# Driver startup and shutdown

SCHEDULE CarpetX_Startup AT startup AS Driver_Startup
{
  LANG: C
} "Start up the driver"

if (!CCTK_Equals(recover, "no") && *recover_file)
{
  SCHEDULE CarpetX_RecoverParameters AT recover_parameters
  {
    LANG:C
    OPTIONS: meta
  } "Recover parameters"
}



# I/O

SCHEDULE CarpetX_CheckpointInitial AT cpinitial
{
  LANG: C
  OPTIONS: meta
} "Checkpoint initial conditions"

SCHEDULE CarpetX_Checkpoint AT checkpoint
{
  LANG: C
  OPTIONS: meta
} "Checkpoint"

SCHEDULE CarpetX_CheckpointTerminate AT terminate
{
  LANG: C
  OPTIONS: meta
} "Checkpoint before terminating"

SCHEDULE CarpetX_Shutdown AT shutdown AS Driver_Shutdown
{
  LANG: C
  OPTIONS: meta
} "Shut down the driver"



# Schedule hooks

# Traversed by the driver, never scheduled into a bin. Thorns may schedule
# routines IN this group; with nothing scheduled the traversal is empty.
# Under subcycling it runs before the reflux: the evolved state and its
# dependents= groups are as the last RK stage's ODESolvers_PostStep left
# them, consistent everywhere (interior, ghosts, outer boundary), without
# the flux-register correction, which the driver applies after this
# traversal and before it restricts.
SCHEDULE GROUP CarpetX_PreRestrict
{
} "Traversed over the time-aligned level window before the driver refluxes and restricts"

# Traversed by the driver, never scheduled into a bin. Thorns may schedule
# routines IN this group; with nothing scheduled the traversal is empty.
# Only on recovery, after RECOVER_VARIABLES and POST_RECOVER_VARIABLES and
# after the per-level iterations and the time step are installed, the driver
# traverses it once per clock window (maximal run of adjacent levels that
# share an iteration), coarse to fine. Inside a window, active_levels,
# cctk_time and cctk_timefac are those evolution's ANALYSIS last saw for these
# levels; cctk_iteration is the checkpointed iteration. A group that is not
# restored from the checkpoint and is SYNCed under subcycling must have its
# producer scheduled here (see the CarpetX documentation, "checkpoint" tag).
# Afterwards the end of initialisation traverses POSTRESTRICT (when the finest
# clock window spans two or more levels), POSTSTEP, CPINITIAL and output over
# the finest clock window with that window's cctk_timefac, as the evolution
# pass that wrote the checkpoint did; only CarpetX_PreRestrict, the reflux, the
# restriction and the prolongation of the restricted groups are not repeated.
SCHEDULE GROUP CarpetX_RecomputeAfterRecovery
{
} "Recompute non-checkpointed groups after recovery; traversed by the driver once per clock window, never scheduled into a bin"
