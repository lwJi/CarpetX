STORAGE: untagged ckpt_no nr nr_ckpt_no ry_ckpt_no nr_explicit

SCHEDULE TestRestrictTags_Init AT initial
{
  LANG: C
  WRITES: untagged(interior)
  WRITES: ckpt_no(interior)
  WRITES: nr(interior)
  WRITES: nr_ckpt_no(interior)
  WRITES: ry_ckpt_no(interior)
  WRITES: nr_explicit(interior)
} "Write coarse_value on level 0 and fine_value on level 1"

SCHEDULE TestRestrictTags_RestrictExplicit AT postinitial
{
  LANG: C
  OPTIONS: global
  READS: nr_explicit(interior)
  WRITES: nr_explicit(interior)
} "Restrict nr_explicit through CarpetX's exported RestrictNoPoison"

SCHEDULE TestRestrictTags_Sync AT postinitial AFTER TestRestrictTags_RestrictExplicit
{
  LANG: C
  OPTIONS: global
  SYNC: untagged
  SYNC: ckpt_no
  SYNC: nr
  SYNC: nr_ckpt_no
  SYNC: ry_ckpt_no
  SYNC: nr_explicit
} "Fill the ghosts of all six groups"

SCHEDULE TestRestrictTags_Check AT analysis
{
  LANG: C
  READS: untagged(interior)
  READS: ckpt_no(everywhere)
  READS: nr(everywhere)
  READS: nr_ckpt_no(everywhere)
  READS: ry_ckpt_no(interior)
  READS: nr_explicit(interior)
} "Check which coarse interiors hold fine_value, and the ghosts of the groups that do not"
