# Schedule definitions for thorn ODESolvers

STORAGE: do_substeps

SCHEDULE ODESolvers_InitConstants AT WRAGH
{
  LANG: C
  OPTIONS: global

  WRITES: do_substeps
} "Set up dummy loop counters for schedule printout"

if(use_subcycling) {

  SCHEDULE ODESolvers_Solve_Subcycling AT evol
  {
    LANG: C
    OPTIONS: level
  } "Solve ODEs with subcycling"

  # Refill refinement-boundary ghosts of the evolved state so they match
  # what a normal-step trajectory would have produced at the same point.
  # CarpetX traverses CarpetX_RecomputeAfterRecovery only on recovery, once
  # per clock window, coarse to fine, with each window on its levels'
  # recovered clock, so this runs once per window and together the windows
  # reach every level. After recovery the coarse-fine ghosts of the
  # integrated state are owned here: with the recovered clocks installed, a
  # SYNC of the integrated state only exchanges same-level ghosts. It runs
  # before ODESolvers_PostStep in the same group, as calcys_rmbnd precedes
  # calcpoststep in an RK stage, so that the state's dependents and the
  # thorns' recomputes read valid state everywhere.
  SCHEDULE ODESolvers_Solve_Subcycling_Recovery IN CarpetX_RecomputeAfterRecovery
  {
    LANG: C
    OPTIONS: level
  } "Refill refinement-boundary ghosts of evolved state after checkpoint recovery"

  SCHEDULE ODESolvers_CheckTimelevels AT CCTK_PARAMCHECK
  {
    LANG: C
    OPTIONS: global
  } "Reject multiple timelevels for evolved groups under subcycling"

} else {

  SCHEDULE ODESolvers_Solve AT evol
  {
    LANG: C
    OPTIONS: level
  } "Solve ODEs"

}

SCHEDULE ODESolvers_CheckMethod AT CCTK_PARAMCHECK
{
  LANG: C
  OPTIONS: global
} "Reject ODE methods the subcycling solver does not implement, and implicit methods when a flux register would need feeding"

SCHEDULE ODESolvers_CheckTags AT CCTK_PARAMCHECK
{
  LANG: C
  OPTIONS: global
} "Reject integrated (rhs=) groups that are not checkpointed or not evolved"



# CarpetX scheduled groups:
#
# Startup:
#   STARTUP (special)
#   WRAGH
#   PARAMCHECK
#
# Initialization:
#   Initialization loop:
#     If regridding:
#       [regrid]
#       BASEGRID (in driver)
#       POSTREGRID (in driver, except for initial coarsest level that is created from scratch)
#     InputGH
#     INITIAL
#     POSTINITIAL
#     POSTPOSTINITIAL
#   On recovery, instead of INITIAL .. POSTPOSTINITIAL:
#     RECOVER_VARIABLES
#     POST_RECOVER_VARIABLES            (once, over all levels)
#     CarpetX_RecomputeAfterRecovery    (once per clock window, coarse to fine)
#   [when restrict_during_sync = no and >= 2 levels are time-aligned:]
#     CarpetX_PreRestrict  (not on recovery)
#     [restrict]    (not on recovery; fine to coarse, then prolongate
#                    restricted GFs; no reflux)
#     POSTRESTRICT  (also on recovery, over the finest clock window)
#   POSTSTEP
#   CPINITIAL
#   ANALYSIS        (not on recovery)
#   OutputGH
#
# Time evolution loop:
#   If regridding:
#     [regrid]
#     BASEGRID (in driver)
#     POSTREGRID (in driver)
#   [cycle time levels]
#   PRESTEP
#   EVOL            (without subcycling: [reflux] inside ODESolvers_Solve,
#                    before the final ODESolvers_PostStep)
#   [when restrict_during_sync = no and >= 2 levels are time-aligned:]
#     CarpetX_PreRestrict  (sees the state before the reflux)
#     [reflux]      (subcycling: finest pair first, once per coarse step)
#     [restrict]    (fine to coarse, then prolongate restricted GFs)
#     POSTRESTRICT  (ODESolvers_PostStep runs here; under subcycling its
#                    SYNC repairs the ghosts after the reflux and the
#                    restriction, and it recomputes the dependents)
#   POSTSTEP        (per level batch under subcycling)
#   ANALYSIS        (per level batch under subcycling)
#   CHECKPOINT      (once, after all batches)
#   OutputGH        (once, after all batches)
#
# Shutdown:
#   TERMINATE
#   SHUTDOWN (special)



# Desirable schedule groups:
#
# Initial condition loop:
#   BaseGrid: Set up constants (e.g. coordinates) everywhere on the grid
#   Initial: Set up initial conditions on interior of state vector
#   PostStep: Apply boundary conditions to state vector, and project if necessary
#   EstimateError: Estimate discretization error (for regridding)
# Analysis: Calculate analysis quantities everywhere
#
# Time evolution loop:
#   EstimateError: Estimate discretization error (for regridding)
#   If regridding:
#     [regrid]
#     [interpolate]
#     BaseGrid: Set up constants (e.g. coordinates) everywhere on the grid
#     PostStep: Apply boundary conditions to state vector, and project if necessary
#   Time stepping loop:
#     RHS: Evaluate RHS for of state vector everywhere on the grid
#     [time step]
#     PostStep: Apply boundary conditions to state vector, and project if necessary
#   Analysis: Calculate analysis quantities everywhere



# BaseGrid: Set up constants (e.g. coordinates) everywhere on the grid
# Initial: Set up initial conditions on interior of state vector
# PostStep: Apply boundary conditions to state vector, and project if necessary
# EstimateError: Estimate discretization error (for regridding)
# Analysis: Calculate analysis quantities everywhere
# RHS: Evaluate RHS for of state vector everywhere on the grid

# TODO: Use only interior of RHS in ODESolver



# Define all groups without scheduling them

  SCHEDULE GROUP ODESolvers_BaseGrid
  {
  } "Set up constants (e.g. coordinates) everywhere on the grid"
  
  SCHEDULE GROUP ODESolvers_Initial
  {
  } "Set up initial conditions on interior of state vector"
  
  SCHEDULE GROUP ODESolvers_PostStep
  {
  } "Apply boundary conditions to state vector, and project if necessary"
  
  SCHEDULE GROUP ODESolvers_RHS
  {
  } "Evaluate RHS for of state vector everywhere on the grid"

  SCHEDULE GROUP ODESolvers_EstimateError
  {
  } "Estimate discretization error (for regridding)"

  SCHEDULE GROUP ODESolvers_Analysis
  {
  } "Calculate analysis quantities everywhere"

  # Traversed only by ODESolvers_Solve, in its IMEX122 / "Implicit Euler"
  # branch (CallScheduleGroup); never scheduled into a bin. Thorns schedule
  # their implicit solve IN this group; with nothing scheduled the traversal
  # is empty. The group must be declared: traversing an undeclared group
  # fails.
  SCHEDULE GROUP ODESolvers_ImplicitStep
  {
  } "Take an implicit step everywhere on the grid"



# Initialization

  SCHEDULE GROUP ODESolvers_BaseGrid AT basegrid
  {
  } "Set up constants (e.g. coordinates) everywhere on the grid"
  
  SCHEDULE GROUP ODESolvers_Initial AT initial
  {
  } "Set up initial conditions on interior of state vector"
  
  SCHEDULE GROUP ODESolvers_PostStep AT postinitial
  {
  } "Apply boundary conditions to state vector, and project if necessary"
  
  # SCHEDULE GROUP ODESolvers_RHS AT postinitial AFTER ODESolvers_PostStep
  # {
  # } "Evaluate RHS for of state vector everywhere on the grid"

  SCHEDULE GROUP ODESolvers_EstimateError AT postinitial AFTER (ODESolvers_PostStep, ODESolvers_RHS)
  {
  } "Estimate discretization error (for regridding)"

# Recovering

  # After a recovery ODESolvers_PostStep and ODESolvers_EstimateError run in
  # exactly one place, chosen by use_subcycling.
  #
  # Under subcycling they run IN CarpetX_RecomputeAfterRecovery, which CarpetX
  # traverses once per clock window, coarse to fine, with that window's levels
  # and clock, after ODESolvers_Solve_Subcycling_Recovery has refilled the
  # coarse-fine ghosts of the integrated state. They are not scheduled AT
  # post_recover_variables: that bin is traversed once over all levels, before
  # the per-level clocks are restored and before the refill, so a PostStep
  # there would see the wrong time on the coarse levels and stale coarse-fine
  # ghosts. A routine scheduled AT post_recover_variables AFTER
  # ODESolvers_PostStep is therefore not ordered against anything under
  # subcycling; it belongs IN CarpetX_RecomputeAfterRecovery AFTER
  # ODESolvers_PostStep.
  #
  # Without subcycling all levels share one clock and there is no refill:
  # both groups run AT post_recover_variables, over all levels, and leave the
  # state and its dependents valid everywhere, so the recompute group does not
  # repeat them. Thorns schedule their own recomputes of non-checkpointed
  # groups IN CarpetX_RecomputeAfterRecovery AFTER ODESolvers_PostStep in both
  # modes; without subcycling that AFTER names no item in the group, and
  # Cactus ignores it.
  if(use_subcycling) {

    SCHEDULE GROUP ODESolvers_PostStep IN CarpetX_RecomputeAfterRecovery AFTER ODESolvers_Solve_Subcycling_Recovery
    {
    } "Apply boundary conditions to state vector, and project if necessary"

    SCHEDULE GROUP ODESolvers_EstimateError IN CarpetX_RecomputeAfterRecovery AFTER ODESolvers_PostStep
    {
    } "Estimate discretization error (for regridding)"

  } else {

    SCHEDULE GROUP ODESolvers_PostStep AT post_recover_variables
    {
    } "Apply boundary conditions to state vector, and project if necessary"

    # SCHEDULE GROUP ODESolvers_RHS AT post_recover_variables AFTER ODESolvers_PostStep
    # {
    # } "Evaluate RHS for of state vector everywhere on the grid"

    SCHEDULE GROUP ODESolvers_EstimateError AT post_recover_variables AFTER (ODESolvers_PostStep, ODESolvers_RHS)
    {
    } "Estimate discretization error (for regridding)"

  }

# Regridding

  SCHEDULE GROUP ODESolvers_PostStep AT postregrid
  {
  } "Apply boundary conditions to state vector, and project if necessary"

# Time evolution

  # # This group will also be scheduled dynamically from ODESolvers_solve
  # SCHEDULE GROUP ODESolvers_PostStep AT poststep
  # {
  # } "Apply boundary conditions to state vector, and project if necessary"
  
  # # This group will also be scheduled dynamically from ODESolvers_solve
  # SCHEDULE GROUP ODESolvers_RHS AT poststep AFTER ODESolvers_PostStep
  # {
  # } "Evaluate the RHS for of state vector everywhere on the grid"

  # TODO: this does not yet handle "IMEX122" correctly
  # this group never actually executes since do_subseteps == 0 always, it is
  # only present to show up in the schedule printout
  SCHEDULE GROUP ODESolvers_CalledBySolve AT EVOL AFTER ODESolvers_Solve WHILE (ODESolvers::do_substeps)
  {
  } "Groups internally scheduled by ODESolvers_Solve"

  SCHEDULE GROUP ODESolvers_RHS IN ODESolvers_CalledBySolve
  {
  } "Evaluate the RHS for of state vector everywhere on the grid"

  SCHEDULE GROUP ODESolvers_PostStep IN ODESolvers_CalledBySolve AFTER ODESolvers_RHS
  {
  } "Apply boundary conditions to state vector, and project if necessary"

  
  SCHEDULE GROUP ODESolvers_EstimateError AT poststep AFTER (ODESolvers_PostStep, ODESolvers_RHS)
  {
  } "Estimate discretization error (for regridding)"

# Restricting

  SCHEDULE GROUP ODESolvers_PostStep AT postrestrict
  {
  } "Apply boundary conditions to state vector, and project if necessary"

# Analysis

  SCHEDULE GROUP ODESolvers_Analysis AT analysis
  {
  } "Calculate analysis quantities everywhere"
