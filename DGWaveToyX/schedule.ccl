# Schedule definitions for thorn DGWaveToyX

SCHEDULE DGWaveToyX_Init IN ODESolvers_Initial
{
  LANG: C
  READS: DGCoordinatesX::coords(interior)
  WRITES: u(interior)
  WRITES: f(interior)
} "Initialise wave equation"

SCHEDULE DGWaveToyX_Boundaries IN ODESolvers_PostStep
{
  LANG: C
  OPTIONS: level
  SYNC: u f
} "Set boundaries of wave equation"

SCHEDULE DGWaveToyX_RHS IN ODESolvers_RHS
{
  LANG: C
  READS: u(everywhere)
  READS: f(everywhere)
  WRITES: u_rhs(interior)
  WRITES: f_rhs(interior)
} "Calculate RHS of wave equation"

# The diagnostics in this group are not checkpointed, and a level that lags
# its parent SYNCs them from the parent: compute them in ODESolvers_Analysis,
# and again after a restart, once the state's ghosts are refilled. This group
# is scheduled after a restart, not ODESolvers_Analysis, which would change
# that group for every thorn.
SCHEDULE GROUP DGWaveToyX_Diagnostics IN ODESolvers_Analysis
{
} "Calculate diagnostics of wave equation"

SCHEDULE GROUP DGWaveToyX_Diagnostics AT post_recover_variables AFTER ODESolvers_PostStep
{
} "Calculate diagnostics of wave equation"

SCHEDULE DGWaveToyX_RHS IN DGWaveToyX_Diagnostics
{
  LANG: C
  READS: u(everywhere)
  READS: f(everywhere)
  WRITES: u_rhs(interior)
  WRITES: f_rhs(interior)
  SYNC: u_rhs f_rhs
} "Calculate RHS of wave equation for output"

SCHEDULE DGWaveToyX_Energy IN DGWaveToyX_Diagnostics
{
  LANG: C
  READS: f(interior)
  WRITES: eps(interior)
  SYNC: eps
} "Calculate energy of wave equation"

# DGWaveToyX_Error does not SYNC, so no other level reads it, and it is not
# recomputed after a restart
SCHEDULE DGWaveToyX_Error IN ODESolvers_Analysis
{
  LANG: C
  READS: DGCoordinatesX::coords(everywhere)
  READS: u(everywhere)
  READS: f(everywhere)
  WRITES: u_error(everywhere)
  WRITES: f_error(everywhere)
} "Calculate error of wave equation"
