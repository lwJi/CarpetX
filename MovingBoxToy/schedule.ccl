# Schedule definitions for thorn MovingBoxToy

# Each level's error estimate must see the box positions at that level's own
# time: move the boxes before every error estimate, including the one after a
# restart, which recomputes each level's estimate as at the end of its last
# step
SCHEDULE GROUP MovingBoxToy_UpdateBoxes AT postinitial BEFORE EstimateError
{
} "Update box positions"

SCHEDULE GROUP MovingBoxToy_UpdateBoxes AT poststep BEFORE EstimateError
{
} "Update box positions"

SCHEDULE GROUP MovingBoxToy_UpdateBoxes AT post_recover_variables BEFORE EstimateError
{
} "Update box positions"

SCHEDULE MovingBoxToy_MoveBoxes IN MovingBoxToy_UpdateBoxes
{
  LANG: C
  READS: BoxInBox::positions
  WRITES: BoxInBox::positions
} "Update box positions"
