# Expected to abort: the fixture for the driver's end-of-step sync check.
# test/subcycle_3levels.par with TestSubcycleStepping::sync_in_tail = yes,
# which schedules TestSubcycleStepping_SyncInTail (SYNC: tail_context) in
# CCTK_ANALYSIS. Under subcycling the SYNC at initialization passes (its
# window holds every level), and the run must abort in iteration 1's
# CCTK_ANALYSIS (window [2,3)) with an error that names the routine, the bin,
# the group and the window. It lives in par/ because the testsuite has no
# expected-failure mode. Run it by hand from a scratch directory; this
# succeeds only if the run aborts with that error:
#
#   ! $CACTUS/exe/cactus_<config> <repo>/TestSubcycleStepping/par/sync_in_tail.par \
#       > sync_in_tail.log 2>&1 &&
#     grep -F 'TestSubcycleStepping::TestSubcycleStepping_SyncInTail (CCTK_ANALYSIS) requested SYNC of TESTSUBCYCLESTEPPING::TAIL_CONTEXT at iteration 1' sync_in_tail.log

ActiveThorns = "
  CarpetX
  ErrorEstimator
  IOUtil
  TestSubcycleStepping
"

Cactus::presync_mode = "mixed-error"

CarpetX::poison_undefined_values = yes

CarpetX::ncells_x = 16
CarpetX::ncells_y = 16
CarpetX::ncells_z = 16

Driver::periodic = "yes"
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes

CarpetX::max_grid_size_x = 10000000
CarpetX::max_grid_size_y = 10000000
CarpetX::max_grid_size_z = 10000000

CarpetX::max_tile_size_x = 10000000
CarpetX::max_tile_size_y = 10000000
CarpetX::max_tile_size_z = 10000000

CarpetX::dtfac = 8.0

Cactus::cctk_itlast = 8

CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no

ErrorEstimator::region_shape = "cube"
ErrorEstimator::scale_by_resolution = "yes"
Driver::regrid_error_threshold = 4.
CarpetX::max_num_levels = 3

IO::out_dir = $parfile
IO::out_every = 1
IO::parfile_write = no
IO::out_fileinfo = "axis labels"

CarpetX::out_adios2_every = 0
CarpetX::out_silo_every = 0
CarpetX::out_openpmd_every = 0

CarpetX::verbose = no
CarpetX::out_performance = no
CarpetX::out_metadata = no
CarpetX::out_tsv_vars = "
  TestSubcycleStepping::iteration
  TestSubcycleStepping::postrestrict
  TestSubcycleStepping::prerestrict
  TestSubcycleStepping::tail_context
  CarpetXRegrid::regrid_error
"

TestSubcycleStepping::sync_in_tail = yes
