ActiveThorns = "
    CarpetX
    CarpetXRegrid
    FluxWaveToyX
    IOUtil
    ODESolvers
"

# First half of the initial-data checkpoint/recover pair for the single-level
# standing wave (standing.par). The run checkpoints its initial data at
# iteration 0 (IO::checkpoint_ID), at CPINITIAL, and runs on as the
# uninterrupted baseline. With a single level CarpetX_PreRestrict is never
# traversed, so prerestrict_energy holds only what POSTINITIAL wrote: its
# output pins that the checkpointed group is defined. recover_initial.par
# continues from that checkpoint; its output must match this run's.

Cactus::cctk_show_schedule = no
Cactus::presync_mode = "mixed-error"

CarpetX::poison_undefined_values = yes

CarpetX::ncells_x = 8
CarpetX::ncells_y = 8
CarpetX::ncells_z = 8

Driver::periodic = "yes"
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes

Cactus::cctk_itlast = 4

FluxWaveToyX::initial_condition = "standing wave"

ODESolvers::method = "RK3"

IO::out_dir = $parfile
IO::out_every = 1
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no
CarpetX::out_performance = no

CarpetX::out_norm_vars = "
    FluxWaveToyX::state
    FluxWaveToyX::error
    FluxWaveToyX::prerestrict_energy
"
CarpetX::out_norm_omit_unstable = yes
CarpetX::out_norm_omit_sumloc_for_backward_compatibility = yes

# Recovery restores only the interior of a checkpointed group, and nothing
# reads prerestrict_energy's ghosts, so they are not refilled: output
# interior points only
CarpetX::out_tsv_output_boundary_points = no
CarpetX::out_tsv_every = 4
CarpetX::out_tsv_vars = "
    FluxWaveToyX::state
    FluxWaveToyX::error
    FluxWaveToyX::prerestrict_energy
"

CarpetX::checkpoint_method = "openpmd"
IO::checkpoint_dir = $parfile + "/checkpoints"
IO::checkpoint_ID = yes
IO::checkpoint_every = 0
IO::checkpoint_on_terminate = no
