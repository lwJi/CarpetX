ActiveThorns = "
    BoxInBox
    CarpetX
    IOUtil
    ODESolvers
    TestSubcyclingMC2
"

TestSubcyclingMC2::initial_condition = "Gaussian"
TestSubcyclingMC2::gaussian_width = 1.0

CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no
CarpetX::report_rk_band_locality = yes

CarpetX::verbose = no

Cactus::cctk_show_schedule = no
Cactus::presync_mode = "mixed-error"

CarpetX::xmin = -32.0
CarpetX::ymin = -32.0
CarpetX::zmin = -32.0

CarpetX::xmax = +32.0
CarpetX::ymax = +32.0
CarpetX::zmax = +32.0

CarpetX::ncells_x = 128
CarpetX::ncells_y = 128
CarpetX::ncells_z = 128

Driver::periodic = "yes"
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes

CarpetX::max_num_levels = 5
Driver::regrid_every = 0
Driver::regrid_error_threshold = 0.9

CarpetX::prolongation_type = "ddf"
CarpetX::ghost_size = 3
CarpetX::dtfac = 0.25

CarpetX::max_grid_size_x = 16
CarpetX::max_grid_size_y = 16
CarpetX::max_grid_size_z = 16

BoxInBox::num_regions = 2

BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = 5
BoxInBox::position_x_1 = -8.0
BoxInBox::radius_1 = [ -1.0, 8.0, 4.0, 2.0, 1.0 ]

BoxInBox::shape_2 = "cube"
BoxInBox::num_levels_2 = 5
BoxInBox::position_x_2 = +8.0
BoxInBox::radius_2 = [ -1.0, 8.0, 4.0, 2.0, 1.0 ]

Cactus::terminate = "iteration"
Cactus::cctk_itlast = 0

ODESolvers::method = "RK4"

IO::out_dir = $parfile
IO::out_every = 0
IO::parfile_write = no
