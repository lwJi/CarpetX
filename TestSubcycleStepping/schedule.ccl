# Schedule definitions for thorn TestSubcycleStepping

STORAGE: iteration postrestrict prerestrict tail_context recovery_counts
STORAGE: tail_count step_counts
STORAGE: conditions loop_stamp if_stamp

schedule TestSubcycleStepping_Init AT INITIAL
{
  LANG: C
  WRITES: iteration(interior)
  WRITES: postrestrict(interior)
  WRITES: prerestrict(interior)
  SYNC: iteration
  SYNC: postrestrict
  SYNC: prerestrict
} "initialize test grid functions"

schedule TestSubcycleStepping_Update AT EVOL
{
  LANG: C
  WRITES: iteration(interior)
  SYNC: iteration
} "update test grid function"

schedule TestSubcycleStepping_PostRestrict AT postrestrict
{
  LANG: C
  WRITES: postrestrict(interior)
  SYNC: postrestrict
} "stamp levels that see CCTK_POSTRESTRICT"

schedule TestSubcycleStepping_PreRestrict IN CarpetX_PreRestrict
{
  LANG: C
  WRITES: prerestrict(interior)
  SYNC: prerestrict
} "stamp levels that see CarpetX_PreRestrict"

schedule TestSubcycleStepping_Sync AT post_recover_variables
{
  LANG: C
  OPTIONS: global
  SYNC: iteration
  SYNC: postrestrict
  SYNC: prerestrict
} "restore the ghost zones, which checkpoints do not carry"



# tail_context: each level records the context of the last end-of-step window
# (CCTK_POSTSTEP) that covered it, and after a restart the context of the
# CCTK_POST_RECOVER_VARIABLES traversal that covered it. It is an end-of-step
# group: under subcycling the driver invalidates it on a level when the level
# steps, until the level's end of step stamps it again.

schedule TestSubcycleStepping_StampTail AT poststep
{
  LANG: C
  WRITES: tail_context(everywhere)
} "stamp the levels of an end-of-step window with its context"

schedule TestSubcycleStepping_StampTail AT post_recover_variables
{
  LANG: C
  WRITES: tail_context(everywhere)
} "stamp the levels of a recovery traversal with its context"



# tail_count: count the end-of-step windows (CCTK_POSTSTEP) that covered each
# level. CCTK_INITIAL, a recovery (once per clock group) and a regrid (on the
# levels it makes or remakes, which it does not prolongate tail_count to)
# restart the count.

schedule TestSubcycleStepping_ResetTailCount AT initial
{
  LANG: C
  WRITES: tail_count(everywhere)
} "zero the end-of-step count"

schedule TestSubcycleStepping_ResetTailCount AT post_recover_variables
{
  LANG: C
  WRITES: tail_count(everywhere)
} "zero the end-of-step count"

schedule TestSubcycleStepping_ResetTailCount AT postregrid
{
  LANG: C
  WRITES: tail_count(everywhere)
} "zero the end-of-step count"

schedule TestSubcycleStepping_CountTail AT poststep
{
  LANG: C
  READS: tail_count(everywhere)
  WRITES: tail_count(everywhere)
} "count the end-of-step windows that cover each level"



# step_counts: count the calls of a global-mode routine in CCTK_POSTSTEP and
# in CCTK_ANALYSIS during the current iteration. The first call in an
# iteration zeroes both counts. One routine per bin, since a routine cannot
# tell which bin calls it.

schedule TestSubcycleStepping_ResetStepCounts AT initial
{
  LANG: C
  OPTIONS: global
  WRITES: step_counts
} "zero the end-of-step call counts"

schedule TestSubcycleStepping_ResetStepCounts AT post_recover_variables
{
  LANG: C
  OPTIONS: global
  WRITES: step_counts
} "zero the end-of-step call counts"

schedule TestSubcycleStepping_CountPostStepCalls AT poststep
{
  LANG: C
  OPTIONS: global
  READS: step_counts
  WRITES: step_counts
} "count the global-mode calls of CCTK_POSTSTEP in this iteration"

schedule TestSubcycleStepping_CountAnalysisCalls AT analysis
{
  LANG: C
  OPTIONS: global
  READS: step_counts
  WRITES: step_counts
} "count the global-mode calls of CCTK_ANALYSIS in this iteration"



# if_stamp, loop_stamp: end-of-step routines that run only conditionally.
# Under subcycling, CarpetX finds its end-of-step groups by traversing
# CCTK_POSTSTEP and CCTK_ANALYSIS at startup without calling any routine,
# with every CCTK_INT grid scalar held at 0, so that it skips every routine
# under a runtime IF and every WHILE loop. Neither group is therefore an
# end-of-step group (the startup log lists the set), and a WHILE loop in
# these bins does not stop the run. Between a level's step and its end of
# step, both hold the values of its previous time, and output at an odd
# iteration shows the if_stamp of the previous even one.

schedule TestSubcycleStepping_SetStampNow AT poststep
{
  LANG: C
  OPTIONS: global
  WRITES: stamp_now
} "let StampIf run at even iterations only"

schedule TestSubcycleStepping_StampIf AT poststep AFTER TestSubcycleStepping_SetStampNow IF TestSubcycleStepping::stamp_now
{
  LANG: C
  WRITES: if_stamp(everywhere)
} "stamp if_stamp under a runtime IF"

schedule TestSubcycleStepping_StartLoop AT analysis BEFORE TestSubcycleStepping_Loop
{
  LANG: C
  OPTIONS: global
  WRITES: loop_passes
} "run the WHILE loop once"

schedule GROUP TestSubcycleStepping_Loop AT analysis WHILE TestSubcycleStepping::loop_passes
{
} "a WHILE loop at the end of step"

schedule TestSubcycleStepping_StampLoop IN TestSubcycleStepping_Loop
{
  LANG: C
  WRITES: loop_stamp(everywhere)
} "stamp loop_stamp inside the WHILE loop"

schedule TestSubcycleStepping_CountLoopPass IN TestSubcycleStepping_Loop AFTER TestSubcycleStepping_StampLoop
{
  LANG: C
  OPTIONS: global
  READS: loop_passes
  WRITES: loop_passes
} "count down the WHILE loop's passes"



# pending_probe: with read_pending_probe = yes, write and SYNC an end-of-step
# result in CCTK_ANALYSIS, then read it everywhere. At iteration 1 of a run
# with several levels, only the finest level runs its end of step, and its
# parent's is pending, so the SYNC leaves its ghosts invalid and the read
# stops the run (par/read-pending.par). The testsuite cannot expect an
# abort, so no test sets the parameter.

if (read_pending_probe) {

  STORAGE: pending_probe

  schedule TestSubcycleStepping_WriteProbe AT analysis
  {
    LANG: C
    WRITES: pending_probe(interior)
    SYNC: pending_probe
  } "write an end-of-step result that a lagging level SYNCs"

  schedule TestSubcycleStepping_ReadProbe AT analysis AFTER TestSubcycleStepping_WriteProbe
  {
    LANG: C
    READS: pending_probe(everywhere)
  } "read that result everywhere, ghosts included"

}



# recovery_counts: count the traversals of each bin from
# CCTK_RECOVER_VARIABLES until CCTK_CPINITIAL, so that the first output after
# a restart shows which bins recovery ran. A fresh start zeroes the counts
# with counting off, so that they stay 0. One routine per bin, since a routine
# cannot tell which bin calls it.

schedule TestSubcycleStepping_ResetCounts AT initial
{
  LANG: C
  OPTIONS: global
  WRITES: recovery_counts
} "zero the recovery counts, with counting off"

schedule TestSubcycleStepping_StartCounting AT recover_variables
{
  LANG: C
  OPTIONS: global
  WRITES: recovery_counts
} "zero the recovery counts and start counting"

schedule TestSubcycleStepping_StopCounting AT cpinitial
{
  LANG: C
  OPTIONS: global
  READS: recovery_counts
  WRITES: recovery_counts
} "stop counting, freezing the counts of what recovery ran"

schedule TestSubcycleStepping_CountPostRecover AT post_recover_variables
{
  LANG: C
  OPTIONS: global
  READS: recovery_counts
  WRITES: recovery_counts
} "count traversals of CCTK_POST_RECOVER_VARIABLES"

schedule TestSubcycleStepping_CountPostStep AT poststep
{
  LANG: C
  OPTIONS: global
  READS: recovery_counts
  WRITES: recovery_counts
} "count traversals of CCTK_POSTSTEP"

schedule TestSubcycleStepping_CountAnalysis AT analysis
{
  LANG: C
  OPTIONS: global
  READS: recovery_counts
  WRITES: recovery_counts
} "count traversals of CCTK_ANALYSIS"

schedule TestSubcycleStepping_CountPreRestrict IN CarpetX_PreRestrict
{
  LANG: C
  OPTIONS: global
  READS: recovery_counts
  WRITES: recovery_counts
} "count traversals of CarpetX_PreRestrict"

schedule TestSubcycleStepping_CountPostRestrict AT postrestrict
{
  LANG: C
  OPTIONS: global
  READS: recovery_counts
  WRITES: recovery_counts
} "count traversals of CCTK_POSTRESTRICT"
