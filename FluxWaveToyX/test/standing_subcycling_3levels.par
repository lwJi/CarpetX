ActiveThorns = "
    BoxInBox
    CarpetX
    CarpetXRegrid
    FluxWaveToyX
    IOUtil
    ODESolvers
"

# Subcycled three-level standing wave on a periodic domain with two nested
# fixed refined boxes, integrated with RK4. Pins the finest-first cascade of
# the driver's flux-register (reflux) correction: at a point where only levels
# 1 and 2 are time-aligned the pair (1,2) is corrected, and at the end of a
# coarse step (1,2) is corrected and then (0,1). With CarpetX::do_reflux at
# its default, the masked sum of every flux-conservative component of
# FluxWaveToyX::state (ft, fx, fy, fz) is constant to round-off over the run.

Cactus::cctk_show_schedule = no
Cactus::presync_mode = "mixed-error"

CarpetX::poison_undefined_values = yes
CarpetX::verbose = no

CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0

CarpetX::xmax = +1.0
CarpetX::ymax = +1.0
CarpetX::zmax = +1.0

CarpetX::ncells_x = 16
CarpetX::ncells_y = 16
CarpetX::ncells_z = 16

Driver::periodic = "yes"
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes

CarpetX::max_num_levels = 3
Driver::regrid_every = 128000
Driver::regrid_error_threshold = 0.9

CarpetX::prolongation_type = "ddf"
CarpetX::ghost_size = 3
CarpetX::dtfac = 0.25

CarpetX::blocking_factor_x = 2
CarpetX::blocking_factor_y = 2
CarpetX::blocking_factor_z = 2
CarpetX::max_grid_size_x = 8
CarpetX::max_grid_size_y = 8
CarpetX::max_grid_size_z = 8

CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no

BoxInBox::num_regions = 1
# Region 1: two nested fixed cubes; regrid_every above keeps them fixed. They
# are displaced from the origin by different amounts in x, y and z so that
# the composite grid has no reflection symmetry: with centred boxes the
# masked totals of fx, fy, fz would vanish by symmetry at every step, whether
# or not the reflux correction is applied.
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = 3
BoxInBox::position_x_1 = 0.25
BoxInBox::position_y_1 = -0.125
BoxInBox::position_z_1 = 0.125
BoxInBox::radius_1 = [ -1.0, 0.5, 0.25 ]

# cctk_iteration counts finest-level steps: 32 finest steps = 8 coarse steps.
# All levels are time-aligned at multiples of 4 only; the masked sums are a
# conservation diagnostic there.
Cactus::cctk_itlast = 32

FluxWaveToyX::initial_condition = "standing wave"

ODESolvers::method = "RK4"

IO::out_dir = $parfile
IO::out_every = 1
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no
CarpetX::out_performance = no

CarpetX::out_norm_vars = "FluxWaveToyX::state"
CarpetX::out_norm_omit_unstable = yes
CarpetX::out_norm_omit_sumloc_for_backward_compatibility = yes

CarpetX::out_tsv_every = 32
CarpetX::out_tsv_vars = "
    FluxWaveToyX::state
    FluxWaveToyX::error
"
