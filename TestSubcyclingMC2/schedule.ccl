# Schedule definitions for thorn TestSubcyclingMC2

STORAGE: state[timelevels] rhs error


SCHEDULE TestSubcyclingMC2_MoveBox AT postinitial BEFORE EstimateError
{
  LANG: C
  READS: BoxInBox::positions
  WRITES: BoxInBox::positions
} "Move the refined box along a linear drift from the origin"

SCHEDULE TestSubcyclingMC2_MoveBox AT poststep BEFORE EstimateError
{
  LANG: C
  READS: BoxInBox::positions
  WRITES: BoxInBox::positions
} "Move the refined box along a linear drift from the origin"

# After a restart, each level's error estimate must see the box position at
# that level's own time, as at the end of its last step
SCHEDULE TestSubcyclingMC2_MoveBox AT post_recover_variables BEFORE EstimateError
{
  LANG: C
  READS: BoxInBox::positions
  WRITES: BoxInBox::positions
} "Move the refined box along a linear drift from the origin"

SCHEDULE TestSubcyclingMC2_Initial AT initial
{
  LANG: C
  WRITES: state(interior)
  SYNC: state
} "Initialize scalar wave state"

SCHEDULE TestSubcyclingMC2_Probe AT PostInitial
{
  LANG: C
  OPTIONS: global
} "Verify STORAGE registry matches schedule.ccl"

SCHEDULE TestSubcyclingMC2_Sync AT postregrid
{
  LANG: C
  OPTIONS: global
  SYNC: state
} "Synchronize"

SCHEDULE TestSubcyclingMC2_Sync AT post_recover_variables
{
  LANG: C
  OPTIONS: global
  SYNC: state
} "Synchronize"

SCHEDULE TestSubcyclingMC2_Sync IN ODESolvers_PostStep
{
  LANG: C
  OPTIONS: global
  SYNC: state
} "Synchronize"

SCHEDULE TestSubcyclingMC2_RHS IN ODESolvers_RHS
{
  LANG: C
  READS: state(everywhere)
  WRITES: rhs(interior)
} "Calculate scalar wave RHS"

SCHEDULE TestSubcyclingMC2_Error AT analysis
{
  LANG: C
  READS: state(interior)
  WRITES: error(interior)
  SYNC: error
} "Calculate error in scalar wave state"

# error is not checkpointed, and a level that lags its parent SYNCs it from
# the parent: recompute it after a restart, once the state's ghosts are
# refilled
SCHEDULE TestSubcyclingMC2_Error AT post_recover_variables AFTER ODESolvers_PostStep
{
  LANG: C
  READS: state(interior)
  WRITES: error(interior)
  SYNC: error
} "Calculate error in scalar wave state"
