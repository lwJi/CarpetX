KEYWORD mode "What TestCarpetXAPI_Register does at WRAGH and TestCarpetXAPI_Fill at CCTK_INITIAL"
{
  "write-scope"       :: "write the interior of state through a write scope that states interior validity, then sync; TestCarpetXAPI_Check reads state everywhere"
  "sync-during-write" :: "call CarpetX::sync on state while a write scope on it is open; CarpetX aborts the run"
  "require-invalid"   :: "require valid ghosts of state before anything has filled them; CarpetX aborts the run"
  "register-twice"    :: "register a valid integrator at WRAGH, then register it again; CarpetX aborts the second call"
  "register-after-use" :: "register a valid integrator at CCTK_INITIAL, after the driver has read its integrator record; CarpetX aborts the run"
  "unregistered-rk-call" :: "call CarpetX::reflux at CCTK_INITIAL without having registered an integrator; CarpetX aborts the run"
  "stages-not-3-or-4" :: "register a 2-stage integrator under CarpetX::use_subcycling; CarpetX aborts the run"
  "reflux-without-reflux-ok" :: "register an integrator with reflux_ok = false that integrates conserved, which carries a fluxes= tag, under CarpetX::do_reflux with CarpetX::max_num_levels > 1; CarpetX aborts the run"
  "subcycling-without-subcycling-ok" :: "register an integrator with subcycling_ok = false under CarpetX::use_subcycling; CarpetX aborts the run"
  "integrated-not-checkpointed" :: "register an integrator that integrates unsaved, which is tagged checkpoint=no; CarpetX aborts the run"
} "write-scope"

CCTK_REAL tolerance "Largest absolute difference between state and the function the fill wrote that TestCarpetXAPI_Check accepts"
{
  0:* :: ""
} 1.0e-10
