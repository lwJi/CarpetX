ActiveThorns = "
    BoxInBox
    CarpetX
    CarpetXRegrid
    IOUtil
    TestCarpetXAPI
"

Cactus::cctk_show_schedule = no
Cactus::presync_mode = "mixed-error"
Cactus::cctk_itlast = 0

CarpetX::verbose = no
CarpetX::poison_undefined_values = no

CarpetX::xmin = -1
CarpetX::ymin = -1
CarpetX::zmin = -1
CarpetX::xmax = +1
CarpetX::ymax = +1
CarpetX::zmax = +1

CarpetX::periodic = yes

CarpetX::ncells_x = 16
CarpetX::ncells_y = 16
CarpetX::ncells_z = 16

CarpetX::max_grid_size_x = 8
CarpetX::max_grid_size_y = 8
CarpetX::max_grid_size_z = 8

CarpetX::max_num_levels = 2
CarpetX::ghost_size = 2

CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no

BoxInBox::num_regions = 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = 2
BoxInBox::radius_1[1] = 0.5

TestCarpetXAPI::mode = "sync-invalid-coarse"

IO::out_dir = $parfile
IO::parfile_write = no

CarpetX::out_metadata = no
CarpetX::out_performance = no
