ActiveThorns = "
    BoxInBox
    CarpetX
    CarpetXRegrid
    FluxWaveToyX
    IOUtil
    ODESolvers
"

# standing_subcycling.par with one diagnostic added to the output: the
# state's energy density averaged over its full ghost width, computed IN
# CarpetX_PreRestrict (FluxWaveToyX_PreRestrictEnergy). Pins that the hook
# runs before the driver's reflux: the coarse cells next to the refined box,
# and their copies in neighbouring coarse boxes' ghosts (across the box faces
# at the domain centre and the periodic domain faces), all hold the
# uncorrected values when CarpetX_PreRestrict is traversed. Refluxing before
# the hook changes prerestrict_energy next to the refined box at iteration 16
# (the end of the last coarse step), whether or not the ghosts are then
# repaired. The state and error output is bit-identical to
# standing_subcycling.

Cactus::cctk_show_schedule = no
Cactus::presync_mode = "mixed-error"

CarpetX::poison_undefined_values = yes
CarpetX::verbose = no

CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0

CarpetX::xmax = +1.0
CarpetX::ymax = +1.0
CarpetX::zmax = +1.0

CarpetX::ncells_x = 16
CarpetX::ncells_y = 16
CarpetX::ncells_z = 16

Driver::periodic = "yes"
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes

CarpetX::max_num_levels = 2
CarpetX::do_reflux = yes
Driver::regrid_every = 128000
Driver::regrid_error_threshold = 0.9

CarpetX::prolongation_type = "ddf"
CarpetX::ghost_size = 3
CarpetX::dtfac = 0.25

CarpetX::blocking_factor_x = 2
CarpetX::blocking_factor_y = 2
CarpetX::blocking_factor_z = 2
CarpetX::max_grid_size_x = 8
CarpetX::max_grid_size_y = 8
CarpetX::max_grid_size_z = 8

CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no

BoxInBox::num_regions = 1
# Region 1: a fixed cube; regrid_every above keeps it fixed. It is displaced
# from the origin by different amounts in x, y and z so that the composite
# grid has no reflection symmetry: with a centred box the masked totals of
# fx, fy, fz would vanish by symmetry at every step, whether or not the
# reflux correction is applied.
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = 2
BoxInBox::position_x_1 = 0.25
BoxInBox::position_y_1 = -0.125
BoxInBox::position_z_1 = 0.125
BoxInBox::radius_1 = [ -1.0, 0.5 ]

# cctk_iteration counts finest-level steps: 16 fine steps = 8 coarse steps.
# The levels are time-aligned at even iterations only; the masked sums are a
# conservation diagnostic there.
Cactus::cctk_itlast = 16

FluxWaveToyX::initial_condition = "standing wave"

ODESolvers::method = "SSPRK3"

IO::out_dir = $parfile
IO::out_every = 1
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no
CarpetX::out_performance = no

CarpetX::out_norm_vars = "FluxWaveToyX::state"
CarpetX::out_norm_omit_unstable = yes
CarpetX::out_norm_omit_sumloc_for_backward_compatibility = yes

CarpetX::out_tsv_every = 16
CarpetX::out_tsv_vars = "
    FluxWaveToyX::state
    FluxWaveToyX::error
    FluxWaveToyX::prerestrict_energy
"
