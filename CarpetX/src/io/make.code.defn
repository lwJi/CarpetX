SRCS =							\
	checkpoint.cxx					\
	io.cxx						\
	io_adios2.cxx					\
	io_meta.cxx					\
	io_norm.cxx					\
	io_openpmd.cxx					\
	io_openpmd_checkpoint.cxx			\
	io_silo.cxx					\
	io_silo_checkpoint.cxx				\
	io_tsv.cxx					\
	selection.cxx

STRAY_DIR := $(dir $(lastword $(MAKEFILE_LIST)))
STRAY_SRCS := $(filter-out $(SRCS),$(notdir $(wildcard $(STRAY_DIR)*.cxx)))
ifneq ($(STRAY_SRCS),)
$(error CarpetX/src/$(notdir $(STRAY_DIR:/=))/make.code.defn: not in SRCS: $(STRAY_SRCS))
endif
