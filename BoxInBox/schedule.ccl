# Schedule definitions for thorn BoxInBox

STORAGE: active num_levels positions radii radiixyz

SCHEDULE BoxInBox_Init AT initial
{
  LANG: C
  OPTIONS: global
  WRITES: active
  WRITES: num_levels
  WRITES: positions
  WRITES: radii
  WRITES: radiixyz
} "Initialize"

# The next regrid reads regrid_error, which is not checkpointed: estimate it
# after initial data, at the end of every step, and again after a restart.
# The group carries the alias EstimateError, so that other thorns can order
# their box updates before it in each bin.
SCHEDULE GROUP BoxInBox_EstimateError AS EstimateError AT postinitial
{
} "Estimate error"

SCHEDULE GROUP BoxInBox_EstimateError AS EstimateError AT poststep
{
} "Estimate error"

SCHEDULE GROUP BoxInBox_EstimateError AS EstimateError AT post_recover_variables
{
} "Estimate error"

SCHEDULE BoxInBox_Setup IN BoxInBox_EstimateError
{
  LANG: C
  READS: active
  READS: num_levels
  READS: positions
  READS: radii
  READS: radiixyz
  WRITES: CarpetXRegrid::regrid_error(interior)
} "Estimate error"
