# Interface definition for thorn TestSubcycleStepping
implements: TestSubcycleStepping

USES INCLUDE HEADER: loop.hxx

CCTK_REAL iteration TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "subcycling and prolongation test"
CCTK_REAL postrestrict TYPE=GF CENTERING={VVV} TAGS='checkpoint="yes" restrict="no"' "levels that saw CCTK_POSTRESTRICT"
CCTK_REAL prerestrict TYPE=GF CENTERING={VVV} TAGS='checkpoint="yes" restrict="no"' "levels that saw CarpetX_PreRestrict"

# The context (cctk_iteration, cctk_time, cctk_timefac) of the last
# CCTK_POSTSTEP or CCTK_POST_RECOVER_VARIABLES traversal whose window covered
# the level, stamped everywhere, and the value of "postrestrict" it saw there
# (a canary: it proves the traversal came after that iteration's
# CCTK_POSTRESTRICT). No other level reads it, so it needs neither a SYNC nor
# a checkpoint. It is an end-of-step result, so under subcycling it is
# invalid on mid-step levels.
CCTK_REAL tail_context TYPE=GF CENTERING={VVV} TAGS='checkpoint="no"'
{
  tail_iteration tail_time tail_timefac tail_postrestrict
} "context of the last end-of-step or recovery traversal that covered each level"

# The CCTK_ANALYSIS twin of tail_context
CCTK_REAL analysis_context TYPE=GF CENTERING={VVV} TAGS='checkpoint="no"'
{
  analysis_iteration analysis_postrestrict
} "context of the last analysis or recovery traversal that covered each level"

# An end-of-step result whose tags ask the driver to restrict it. Under
# subcycling the driver never does: the levels that a window's restriction
# reads have stepped since their last end of step, so they hold it as
# invalid, and the end of step that follows rewrites it on every window
# level. It is also stamped at CCTK_INITIAL, so that it is valid wherever
# nothing has invalidated it. Not checkpointed, so that the frozen
# checkpoints of the recover tests still recover, and not output, since the
# end of step overwrites whatever a restriction would have left.
CCTK_REAL restricted_result TYPE=GF CENTERING={VVV} TAGS='checkpoint="no" restrict="yes"' "end-of-step result tagged for restriction"

# Number of traversals of CCTK_POSTSTEP and CCTK_ANALYSIS, the initial-data
# traversals included, since the start of the run or the restart. Not
# checkpointed, so that checkpoints written before these counts existed still
# recover; a restart zeroes them at CCTK_RECOVER_VARIABLES.
CCTK_INT step_counts TYPE=SCALAR TAGS='checkpoint="no"'
{
  step_count_poststep step_count_analysis
} "traversals of CCTK_POSTSTEP and CCTK_ANALYSIS"

# Number of traversals of the bins a recovery might run, counted from
# CCTK_RECOVER_VARIABLES until CCTK_CPINITIAL ("counting" is 1 in between and
# 0 otherwise)
CCTK_INT recovery_counts TYPE=SCALAR TAGS='checkpoint="no"'
{
  count_post_recover count_poststep count_analysis count_prerestrict count_postrestrict counting
} "traversals of each bin during recovery"
