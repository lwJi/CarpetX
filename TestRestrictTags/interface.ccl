IMPLEMENTS: TestRestrictTags

USES INCLUDE HEADER: loop.hxx
USES INCLUDE HEADER: schedule.hxx



CCTK_REAL untagged TYPE=GF CENTERING={VVV} "no tags: restricted"

CCTK_REAL ckpt_no TYPE=GF CENTERING={VVV} TAGS='checkpoint="no"' "not checkpointed, no restrict tag"

CCTK_REAL nr TYPE=GF CENTERING={VVV} TAGS='restrict="no"' "restriction disabled"

CCTK_REAL nr_ckpt_no TYPE=GF CENTERING={VVV} TAGS='checkpoint="no" restrict="no"' "not checkpointed, restriction disabled"

CCTK_REAL ry_ckpt_no TYPE=GF CENTERING={VVV} TAGS='checkpoint="no" restrict="yes"' "not checkpointed, restriction enabled"

CCTK_REAL nr_explicit TYPE=GF CENTERING={VVV} TAGS='restrict="no"' "restriction disabled, restricted explicitly"
