# Parameter definitions for thorn TestSubcyclingMC2

KEYWORD initial_condition "Initial condition"
{
  "standing wave" :: "Standing wave"
  "Gaussian" :: "Gaussian"
} "standing wave"

CCTK_REAL amplitude "Initial amplitude"
{
  *:* :: ""
} 1.0

CCTK_REAL standing_wave_kx "kx for standing wave"
{
  *:* :: ""
} 0.5

CCTK_REAL standing_wave_ky "kz for standing wave"
{
  *:* :: ""
} 0.5

CCTK_REAL standing_wave_kz "ky for standing wave"
{
  *:* :: ""
} 0.5

CCTK_REAL gaussian_width "width of Gaussian"
{
  (0:* :: ""
} 1.0

CCTK_REAL epsdiss "Dissipation coefficient <arXiv:gr-qc/0610128>" STEERABLE=always
{
  0.0:* :: ""
} 0.0

INT timelevels "Number of time levels for the state" STEERABLE=recover
{
  0:3 :: ""
} 1

CCTK_REAL box_velocity_x "x-velocity of the refined box (linear drift anchored at the origin)"
{
  *:* :: ""
} 0.0

CCTK_REAL box_velocity_y "y-velocity of the refined box (linear drift anchored at the origin)"
{
  *:* :: ""
} 0.0

CCTK_REAL box_velocity_z "z-velocity of the refined box (linear drift anchored at the origin)"
{
  *:* :: ""
} 0.0

CCTK_INT add_level_at_iteration "From this iteration on, refined region 0 asks for one more refinement level than BoxInBox::num_levels_1"
{
  -1 :: "never"
  0:* :: ""
} -1

