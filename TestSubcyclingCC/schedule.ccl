# Schedule definitions for thorn TestSubcyclingCC

STORAGE: state rhs error


SCHEDULE TestSubcyclingCC_Initial AT initial
{
  LANG: C
  WRITES: state(interior)
  SYNC: state
} "Initialize scalar wave state"

SCHEDULE TestSubcyclingCC_Sync AT postregrid
{
  LANG: C
  OPTIONS: global
  SYNC: state
} "Synchronize"

SCHEDULE TestSubcyclingCC_Sync AT post_recover_variables
{
  LANG: C
  OPTIONS: global
  SYNC: state
} "Synchronize"

SCHEDULE TestSubcyclingCC_Sync IN ODESolvers_PostStep
{
  LANG: C
  OPTIONS: global
  SYNC: state
} "Synchronize"

SCHEDULE TestSubcyclingCC_RHS IN ODESolvers_RHS
{
  LANG: C
  READS: state(everywhere)
  WRITES: rhs(interior)
} "Calculate scalar wave RHS"

# error is not checkpointed, and a level that lags its parent SYNCs it from
# the parent: compute it at the end of each step, and again after a restart,
# once the state's ghosts are refilled
SCHEDULE GROUP TestSubcyclingCC_Diagnostics AT analysis
{
} "Calculate scalar wave diagnostics"

SCHEDULE GROUP TestSubcyclingCC_Diagnostics AT post_recover_variables AFTER ODESolvers_PostStep
{
} "Calculate scalar wave diagnostics"

SCHEDULE TestSubcyclingCC_Error IN TestSubcyclingCC_Diagnostics
{
  LANG: C
  READS: state(interior)
  WRITES: error(interior)
  SYNC: error
} "Calculate error in scalar wave state"
