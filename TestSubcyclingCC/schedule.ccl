# Schedule definitions for thorn TestSubcyclingCC

STORAGE: state rhs error


SCHEDULE TestSubcyclingCC_Initial AT initial
{
  LANG: C
  WRITES: state(interior)
  SYNC: state
} "Initialize scalar wave state"

SCHEDULE TestSubcyclingCC_Sync AT postregrid
{
  LANG: C
  OPTIONS: global
  SYNC: state
} "Synchronize"

SCHEDULE TestSubcyclingCC_Sync AT post_recover_variables
{
  LANG: C
  OPTIONS: global
  SYNC: state
} "Synchronize"

SCHEDULE TestSubcyclingCC_Sync IN ODESolvers_PostStep
{
  LANG: C
  OPTIONS: global
  SYNC: state
} "Synchronize"

SCHEDULE TestSubcyclingCC_RHS IN ODESolvers_RHS
{
  LANG: C
  READS: state(everywhere)
  WRITES: rhs(interior)
} "Calculate scalar wave RHS"

SCHEDULE TestSubcyclingCC_Error AT analysis
{
  LANG: C
  READS: state(interior)
  WRITES: error(interior)
  SYNC: error
} "Calculate error in scalar wave state"

# error is not checkpointed. Recompute it on every level after recovery: a
# checkpoint can land while the fine levels are behind the coarse ones, and
# the first post-recovery ANALYSIS may then run on fine levels only, whose
# SYNC prolongates error from a coarse level that has not run ANALYSIS yet.
SCHEDULE TestSubcyclingCC_Error AT post_recover_variables AFTER ODESolvers_PostStep
{
  LANG: C
  READS: state(interior)
  WRITES: error(interior)
  SYNC: error
} "Recompute error after recovery"
