STORAGE: active num_levels positions radii radiixyz

SCHEDULE BoxInBox_Init AT initial
{
  LANG: C
  OPTIONS: global
  WRITES: active
  WRITES: num_levels
  WRITES: positions
  WRITES: radii
  WRITES: radiixyz
} "Initialize"

SCHEDULE GROUP BoxInBox_EstimateError AS EstimateError AT postinitial
{
} "Estimate error"

SCHEDULE GROUP BoxInBox_EstimateError AS EstimateError AT poststep
{
} "Estimate error"

SCHEDULE GROUP BoxInBox_EstimateError AS EstimateError AT post_recover_variables
{
} "Estimate error"

SCHEDULE BoxInBox_Setup IN BoxInBox_EstimateError
{
  LANG: C
  READS: active
  READS: num_levels
  READS: positions
  READS: radii
  READS: radiixyz
  WRITES: CarpetXRegrid::regrid_error(interior)
} "Estimate error"
