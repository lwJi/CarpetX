# Schedule definitions for thorn SpacetimeWaveToyX

STORAGE: ustate ftstate fxstate fystate fzstate
STORAGE: curlfx curlfy curlfz
STORAGE: energy
STORAGE: uerror fterror fxerror fyerror fzerror

SCHEDULE SpacetimeWaveToyX_Initial AT initial
{
  LANG: C
  WRITES: ustate(interior)
  WRITES: ftstate(interior)
  WRITES: fxstate(interior)
  WRITES: fystate(interior)
  WRITES: fzstate(interior)
  SYNC: ustate
  SYNC: ftstate
  SYNC: fxstate
  SYNC: fystate
  SYNC: fzstate
} "Initialize scalar wave state"

SCHEDULE SpacetimeWaveToyX_Evol1 AT evol
{
  LANG: C
  # inputs
  READS: ftstate(interior)
  # modified
  READS: ustate(interior)
  READS: fxstate(interior)
  READS: fystate(interior)
  READS: fzstate(interior)
  WRITES: ustate(interior)
  WRITES: fxstate(interior)
  WRITES: fystate(interior)
  WRITES: fzstate(interior)
  SYNC: ustate
  SYNC: fxstate
  SYNC: fystate
  SYNC: fzstate
} "Evolve scalar wave, part 1"

SCHEDULE SpacetimeWaveToyX_Evol2 AT evol AFTER SpacetimeWaveToyX_Evol1
{
  LANG: C
  # inputs
  READS: fxstate(everywhere)
  READS: fystate(everywhere)
  READS: fzstate(everywhere)
  # modified
  READS: ftstate(interior)
  WRITES: ftstate(interior)
  SYNC: ftstate
} "Evolve scalar wave, part 2"

SCHEDULE SpacetimeWaveToyX_Constraints AT analysis
{
  LANG: C
  READS: fxstate(interior)
  READS: fystate(interior)
  READS: fzstate(interior)
  WRITES: curlfx(interior)
  WRITES: curlfy(interior)
  WRITES: curlfz(interior)
  SYNC: curlfx
  SYNC: curlfy
  SYNC: curlfz
} "Calculate scalar wave constraints"
 
SCHEDULE SpacetimeWaveToyX_Energy AT analysis
{
  LANG: C
  READS: ftstate(everywhere)
  READS: fxstate(everywhere)
  READS: fystate(everywhere)
  READS: fzstate(everywhere)
  WRITES: energy(interior)
  SYNC: energy
} "Calculate scalar wave energy density"

SCHEDULE SpacetimeWaveToyX_Error AT analysis
{
  LANG: C
  READS: ustate(interior)
  READS: ftstate(interior)
  READS: fxstate(interior)
  READS: fystate(interior)
  READS: fzstate(interior)
  WRITES: uerror(interior)
  WRITES: fterror(interior)
  WRITES: fxerror(interior)
  WRITES: fyerror(interior)
  WRITES: fzerror(interior)
  SYNC: uerror
  SYNC: fterror
  SYNC: fxerror
  SYNC: fyerror
  SYNC: fzerror
} "Calculate error in scalar wave state"

# Recovery. Checkpoints carry the interior only, so restore the state's ghosts
# with a SYNC; the evolution reads only the interior, but the energy reads the
# ghosts. The diagnostics above are not checkpointed, and a level that lags
# its parent SYNCs them from the parent: recompute them after a restart.
SCHEDULE SpacetimeWaveToyX_Sync AT post_recover_variables
{
  LANG: C
  OPTIONS: global
  SYNC: ustate
  SYNC: ftstate
  SYNC: fxstate
  SYNC: fystate
  SYNC: fzstate
} "Restore the ghosts of the state, which checkpoints do not carry"

SCHEDULE SpacetimeWaveToyX_Constraints AT post_recover_variables AFTER SpacetimeWaveToyX_Sync
{
  LANG: C
  READS: fxstate(interior)
  READS: fystate(interior)
  READS: fzstate(interior)
  WRITES: curlfx(interior)
  WRITES: curlfy(interior)
  WRITES: curlfz(interior)
  SYNC: curlfx
  SYNC: curlfy
  SYNC: curlfz
} "Calculate scalar wave constraints"

SCHEDULE SpacetimeWaveToyX_Energy AT post_recover_variables AFTER SpacetimeWaveToyX_Sync
{
  LANG: C
  READS: ftstate(everywhere)
  READS: fxstate(everywhere)
  READS: fystate(everywhere)
  READS: fzstate(everywhere)
  WRITES: energy(interior)
  SYNC: energy
} "Calculate scalar wave energy density"

SCHEDULE SpacetimeWaveToyX_Error AT post_recover_variables AFTER SpacetimeWaveToyX_Sync
{
  LANG: C
  READS: ustate(interior)
  READS: ftstate(interior)
  READS: fxstate(interior)
  READS: fystate(interior)
  READS: fzstate(interior)
  WRITES: uerror(interior)
  WRITES: fterror(interior)
  WRITES: fxerror(interior)
  WRITES: fyerror(interior)
  WRITES: fzerror(interior)
  SYNC: uerror
  SYNC: fterror
  SYNC: fxerror
  SYNC: fyerror
  SYNC: fzerror
} "Calculate error in scalar wave state"
