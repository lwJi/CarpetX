ActiveThorns = "
    CarpetX
    IOUtil
    TestStorageKeyword
"

Cactus::cctk_itlast = 3
Cactus::presync_mode = "mixed-error"

CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0

CarpetX::xmax = 1.0
CarpetX::ymax = 1.0
CarpetX::zmax = 1.0

CarpetX::ncells_x = 4
CarpetX::ncells_y = 4
CarpetX::ncells_z = 4

CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1

CarpetX::max_num_levels = 1

IO::out_dir = $parfile
IO::out_every = 1
IO::parfile_write = no

CarpetX::out_metadata = no
CarpetX::out_tsv_vars = "
    TestStorageKeyword::storaged_arr
    TestStorageKeyword::storaged_arr3
"
